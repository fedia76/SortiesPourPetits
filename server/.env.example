# Copiez ce fichier en .env et adaptez les valeurs.

# Connexion MySQL (créez la base : CREATE DATABASE sortiespourpetits;)
DATABASE_URL="mysql://sortiespourpetits_API:password@localhost:3306/sortiespourpetits"

# Secret de signature des sessions (générez-en un : openssl rand -hex 32)
JWT_SECRET="changez-moi"

# Port de l'API
PORT=3000

# À positionner à "production" sur le serveur : active les cookies "secure"
# (HTTPS uniquement), la prise en compte du reverse proxy (IP, protocole), et
# l'indexation par les moteurs. Tant que la variable ne vaut pas "production",
# robots.txt interdit tout et chaque page est servie en "noindex" — de quoi
# éviter qu'une préproduction ne se retrouve dans les résultats de recherche.
NODE_ENV=development

# Adresse publique du site, sans barre finale. Elle sert à écrire les adresses
# canoniques, le sitemap et les aperçus de partage, qui doivent être absolues.
# À défaut, elle est déduite de la requête — ce qui marche, mais dépend alors
# du nom par lequel on est arrivé.
PUBLIC_BASE_URL="https://votre-domaine.fr"

# Le front compilé, que l'API sert elle-même (pré-rendu des pages publiques).
# Par défaut, le dossier `client/` à côté de `server/` — ce que le déploiement
# met en place. À ne renseigner que pour une autre disposition.
# CLIENT_DIR="/opt/sortiespourpetits/client"

# --- Uniquement pour le seed de production (npm run db:seed:prod) ---
# Ne jamais mettre le mot de passe en clair ici. Générez le hash localement :
#   npm run hash-password -- 'mon-mot-de-passe'
# et collez le résultat dans ADMIN_PASSWORD_HASH.
ADMIN_EMAIL="admin@exemple.fr"
ADMIN_PASSWORD_HASH="$2b$12$ifbWpetV6ZHbF2puIywVjO62yV8DPt/urwijrzadvEL60H/K231Ay"
ADMIN_DISPLAY_NAME="Admin"
