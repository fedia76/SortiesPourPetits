generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Setting {
  INDOOR
  OUTDOOR
  BOTH
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pourquoi une sortie a été refusée — la version comptable du motif.
///
/// Le texte libre reste (`Event.rejectionReason`) : c'est lui que l'auteur
/// lit, et aucune liste ne dira jamais tout d'un cas particulier. Mais du
/// texte libre ne s'additionne pas — « pas pour les enfants », « trop vieux »
/// et « 12+ » sont une seule information et trois chaînes — et il ne pouvait
/// donc rien apprendre au scraper.
///
/// La règle qui a présidé au choix de ces valeurs : **un motif n'est utile
/// que s'il désigne un étage.** Chacune ci-dessous se lit comme un reproche
/// adressé à une brique précise du pipeline ; ce qui n'en désigne aucune n'a
/// rien à faire ici et reste dans le texte libre, sous `AUTRE`.
enum RejectionCode {
  /// Ce n'est pas une sortie. Étages 2 (reconnaissance) et 6 (extraction).
  HORS_SUJET
  /// C'en est une, mais pas pour ce public. Étages 1 (requête) et 6 (prompt).
  PAS_POUR_ENFANTS
  /// Les dates sont fausses. Étage 6, et `schedule.py`.
  DATE_FAUSSE
  /// Le lieu est faux ou introuvable. Étage 6, et `geocode.py`.
  LIEU_FAUX
  /// Le tarif est faux. Étage 6.
  TARIF_FAUX
  /// La description est inutilisable — tronquée, illisible, hors sujet.
  /// Étage 5 (lecture) avant l'étage 6 : c'est là que le texte se fabrique.
  DESCRIPTION_INUTILISABLE
  /// `sourceUrl` ne mène pas à cette sortie. Étage 7 (attribution).
  MAUVAIS_LIEN
  /// La sortie est déjà au catalogue. Le dédoublonnage, qui ne connaît
  /// aujourd'hui que les URL.
  DOUBLON
  /// La sortie est passée. `payload._clean_dates`, et la fraîcheur d'un run.
  DEJA_PASSEE
  /// Aucun étage en cause, ou plusieurs : le texte libre fait foi.
  AUTRE
}

enum ScraperRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Où en est l'analyse d'un agenda du banc d'évaluation.
///
/// Les quatre premiers états sont ceux d'un travail que le worker réclame,
/// exactement comme une exécution du scraper. `VALIDATED` est le seul que le
/// worker ne produit jamais : il dit qu'un humain a relu la moisson, l'a
/// complétée, et que ce qu'elle contient fait désormais **vérité**.
enum EvalAgendaStatus {
  QUEUED
  RUNNING
  ANALYZED
  FAILED
  VALIDATED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  events          Event[]          @relation("EventAuthor")
  moderatedEvents Event[]          @relation("EventModerator")
  apiKeys         ApiKey[]
  scraperRuns     ScraperRun[]     @relation("ScraperRunRequester")
  evalAgendas     EvalAgenda[]     @relation("EvalAgendaAuthor")
  evalReadings    EvalReading[]    @relation("EvalReadingAuthor")
  evalExtractions EvalExtraction[] @relation("EvalExtractionAuthor")
}

/// Clé d'API pour les programmes tiers. La clé en clair n'est jamais stockée :
/// seul son hash SHA-256 l'est, et elle agit avec le rôle du compte rattaché.
model ApiKey {
  id         Int       @id @default(autoincrement())
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@index([userId])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  events Event[]
}

/// Une zone géographique ouverte sur le site : l'Île-de-France, Le Havre…
///
/// Elle existe d'abord pour les visiteurs et les moteurs de recherche. Personne
/// ne cherche « sortie enfant » tout court — on cherche « sortie enfant Nancy »,
/// et il faut une page qui réponde exactement à cette question, avec son propre
/// titre et son propre texte.
///
/// L'appartenance se décide sur le code postal du lieu, par préfixes : c'est le
/// mécanisme que les recherches automatiques utilisent déjà (`postalPrefixes`),
/// il ne dépend d'aucun géocodage, et redessiner une zone revient à modifier
/// une liste.
model Area {
  id             Int      @id @default(autoincrement())
  /// Ce qui apparaît dans l'adresse : « ile-de-france ».
  slug           String   @unique
  name           String   @unique
  /// Préfixes de code postal séparés par des virgules : « 75,77,78,91 ».
  postalPrefixes String
  /// Texte de présentation, affiché en tête de page et repris en description.
  /// C'est ce qui distingue la page d'une simple liste filtrée.
  intro          String   @db.Text
  /// Ordre d'affichage dans les menus et les listes.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
}

model Venue {
  id         Int     @id @default(autoincrement())
  name       String
  address    String
  city       String
  postalCode String
  lat        Decimal @db.Decimal(9, 6)
  lng        Decimal @db.Decimal(9, 6)

  events Event[]

  @@index([lat, lng])
  @@index([postalCode])
}

model Event {
  id              Int            @id @default(autoincrement())
  title           String
  description     String         @db.Text
  /// Le **meilleur lien connu** pour cette sortie : la page de l'organisateur
  /// quand on a su la trouver, la page où elle a été repérée sinon. C'est
  /// celui que la fiche montre, et il n'a jamais changé de rôle — de sorte
  /// qu'aucun lecteur de ce champ n'a eu à apprendre les deux suivants.
  sourceUrl       String?
  /// La page où la recherche automatique a trouvé la sortie, quand elle
  /// diffère de `sourceUrl` — typiquement un agrégateur qui republiait
  /// l'information d'un musée. Vide pour une proposition de visiteur, et vide
  /// aussi quand la page lue était déjà la bonne : ce champ ne se remplit que
  /// s'il apprend quelque chose.
  foundOnUrl      String?
  /// Ce qui a désigné `sourceUrl` : `json_ld`, `venue_domain`, `page_link`,
  /// `search` (l'étage attribution du scraper, du plus sûr au moins sûr) ou
  /// `manuel` quand un humain l'a saisi ou corrigé. Le modérateur voit ainsi
  /// quelle confiance accorder au lien qu'on lui propose.
  sourceUrlSignal String?
  isFree          Boolean        @default(false)
  price           Decimal?       @db.Decimal(8, 2)
  photoUrl        String?
  ageMin          Int?
  ageMax          Int?
  isPermanent     Boolean        @default(false)
  dateStart       DateTime?      @db.Date
  dateEnd         DateTime?      @db.Date
  openTime        String? // "HH:MM", valable tous les jours de l'évènement
  closeTime       String? // "HH:MM", valable tous les jours de l'évènement
  setting         Setting?
  status          EventStatus    @default(PENDING)
  rejectionReason String?
  /// Le même refus, sous une forme qui s'additionne. Nul pour les sorties
  /// refusées avant ce champ, et pour celles qui ne sont pas refusées.
  rejectionCode   RejectionCode?
  createdAt       DateTime       @default(now())

  venue   Venue @relation(fields: [venueId], references: [id])
  venueId Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  author      User @relation("EventAuthor", fields: [createdById], references: [id])
  createdById Int

  moderator     User? @relation("EventModerator", fields: [moderatedById], references: [id])
  moderatedById Int?

  /// Jours où la sortie a effectivement lieu. Vide = tous les jours de la
  /// période, ce qui reste le cas le plus courant.
  dates EventDate[]

  scraperItems ScraperRunItem[]
  scrapedUrls  ScrapedUrl[]
  /// Ce qu'un modérateur a corrigé avant d'approuver cette fiche.
  corrections  EventCorrection[]
  /// Les pages du banc de lecture dont cette sortie est la vérité de référence.
  evalReadings EvalReading[]
  /// Les recherches de source demandées sur cette sortie depuis sa fiche.
  sourceHunts  ScraperRun[]      @relation("SourceHunt")

  @@index([status, dateEnd])
  @@index([createdById])
  @@index([categoryId])
}

/// Une recherche paramétrée du scraper. Le thème, la période et la zone
/// orientent la recherche ; ils ne filtrent pas le résultat (voir
/// `keepOutOfScope`). Plusieurs configurations spécialisées se complètent :
/// chacune ratisse son angle et ramasse au passage ce que les autres ratent.
/// Un jour de représentation.
///
/// `dateStart`/`dateEnd` bornent la sortie et servent à l'affichage ; ces
/// lignes disent quels jours de cette période elle a réellement lieu. Un
/// spectacle joué tous les dimanches de juillet et août en a neuf — sans quoi
/// il ressortirait un jeudi.
///
/// Aucune ligne veut dire « tous les jours de la période » : c'est le cas
/// d'une exposition ou d'une fête foraine, et c'était le seul modèle possible
/// avant cette table.
model EventDate {
  id      Int      @id @default(autoincrement())
  day     DateTime @db.Date
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  @@unique([eventId, day])
  @@index([day])
}

/// Un champ qu'un modérateur a corrigé sur une fiche importée, avant de la
/// juger. Une ligne par champ, et la valeur d'avant comme celle d'après.
///
/// C'est la vérité terrain la moins chère du projet : personne n'étiquette
/// rien, on enregistre un geste que la modération faisait déjà. Et c'est la
/// seule qui dise **où** l'extraction se trompe — un taux d'approbation dit
/// qu'une fiche était mauvaise, cette table dit que c'était la ville.
///
/// Elle ne se remplit que dans un cas étroit, et c'est délibéré : une fiche
/// encore en attente, importée par la recherche automatique. Une retouche
/// éditoriale six mois après approbation n'est pas une erreur d'extraction, et
/// la compter ici brouillerait la mesure comme le comptage de liens avait
/// brouillé le classifieur.
model EventCorrection {
  id      Int      @id @default(autoincrement())
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  /// Le champ de la fiche, sous le nom que lui donne l'API : `title`,
  /// `venueCity`, `price`, `dateStart`… Le même vocabulaire que le payload du
  /// scraper, pour que la mesure se lise en regard de l'étage 6.
  field   String   @db.VarChar(40)
  /// Ce que le scraper avait proposé, et ce que l'humain a mis à la place.
  /// Tronqués : on mesure une fréquence, on ne rejoue pas la fiche.
  before  String?  @db.VarChar(500)
  after   String?  @db.VarChar(500)
  at      DateTime @default(now())

  @@index([eventId])
  @@index([field])
}

/// Un **agrégateur** : un grand agenda qui republie — kidiklik, citizenkid,
/// sortiraparis…
///
/// Ce sont d'excellents points d'entrée — ils indexent tout et sortent en tête
/// des recherches — mais un atelier du musée Rodin est une information du
/// musée Rodin. Le scraper les lit, puis remonte à la page de l'organisateur,
/// et c'est celle-là qu'il propose.
///
/// La liste est **commune à toutes les recherches** : une même page vaut la
/// même chose quelle que soit la recherche qui l'a trouvée, et la régler
/// recherche par recherche revenait à la recopier à chaque fois — donc à
/// l'oublier quelque part. Chaque recherche décide seulement, par une case à
/// cocher, si elle les lit ou les refuse.
model Aggregator {
  id      Int     @id @default(autoincrement())
  /// Le domaine, sans `www.` ni schéma : `kidiklik.fr`. Les sous-domaines en
  /// relèvent aussi — le scraper compare la fin de l'hôte.
  domain  String  @unique
  /// Nom lisible, pour la console. Vide : le domaine fait office de nom.
  label   String  @default("")
  /// Faux : le site cesse d'être tenu pour un agrégateur. Ses pages peuvent
  /// alors servir de source à une sortie, et une recherche qui bloque les
  /// agrégateurs ne le bloquera pas. La ligne est conservée : on saura
  /// pourquoi elle avait été écrite.
  enabled Boolean @default(true)
  /// Ce qu'on a constaté sur ce site — utile au prochain qui se demandera
  /// pourquoi il est là, ou pourquoi il a été désactivé.
  note    String  @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScraperConfig {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  enabled Boolean @default(true)

  /// « recherche » (le modèle cherche sur le web) ou « site » (on part
  /// d'adresses connues, sans la moindre recherche). Les configurations
  /// existantes gardent « recherche » et le chemin qu'elles avaient.
  mode     String @default("recherche")
  /// Points de départ du mode « site », une URL par ligne. Vide ailleurs.
  seedUrls String @default("") @db.Text

  theme       String @db.Text
  area        String @default("Île-de-France")
  period      String @default("les prochaines semaines")
  horizonDays Int    @default(30)

  maxEvents         Int     @default(20)
  maxSearches       Int     @default(6)
  maxAgendas        Int     @default(6)
  /// Pages suivantes d'un agenda, suivies tant que la moisson est maigre.
  maxNextPages      Int     @default(2)
  maxLinksPerAgenda Int     @default(8)
  maxPageChars      Int     @default(8000)
  maxCostUsd        Decimal @default(1.00) @db.Decimal(6, 2)
  keepOutOfScope    Boolean @default(true)

  defaultCategory  String  @default("Non classé")
  /// Préfixes de codes postaux visés, séparés par des virgules.
  postalPrefixes   String  @default("75,77,78,91,92,93,94,95")
  /// Ne pas seulement remonter à la source depuis un agrégateur : refuser de
  /// le lire. La liste, elle, est commune au site (`Aggregator`) et ne se
  /// règle plus recherche par recherche. Les pages illisibles (réseaux
  /// sociaux) restent écartées dans tous les cas, par le scraper.
  blockAggregators Boolean @default(false)
  /// Autorise l'attribution à *chercher* la page de l'organisateur quand la
  /// page lue ne la porte pas. Son seul appel payant, ~0,001 $ la fiche.
  sourceSearch     Boolean @default(true)

  /// Qui lance les recherches : « anthropic » (outil serveur) ou « serper »
  /// (Google). Le modèle reste derrière dans les deux cas pour le reste.
  provider        String @default("anthropic")
  /// Tranche la nature d'une page quand aucun signal certain ne la donne.
  /// Vide : on ne demande à personne, et la page part en agenda.
  classifyModel   String @default("claude-haiku-4-5")
  searchModel     String @default("claude-haiku-4-5")
  selectModel     String @default("claude-haiku-4-5")
  extractionModel String @default("claude-haiku-4-5")

  /// Requêtes imposées, une par ligne. Vide : le modèle les formule.
  queries String? @db.Text

  /// Prompts personnalisés ; vides, le scraper utilise les siens.
  queriesPrompt         String? @db.Text
  classifyPrompt        String? @db.Text
  searchPrompt          String? @db.Text
  selectPrompt          String? @db.Text
  extractionPrompt      String? @db.Text
  /// Lecture d'une page de programme, qui porte plusieurs sorties (mode « site »).
  extractionMultiPrompt String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ScraperRun[]
}

/// Une exécution : mise en file depuis la console, prise en charge par le
/// worker, puis close avec ses compteurs.
model ScraperRun {
  id     Int              @id @default(autoincrement())
  status ScraperRunStatus @default(QUEUED)
  /// Faux : le run explore sans rien proposer au site.
  submit Boolean          @default(false)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?   @db.Text

  candidates Int @default(0)
  /// Pages d'agenda téléchargées, pages suivantes comprises.
  pages      Int @default(0)
  /// Celles qui n'étaient pas la première page d'un agenda. `pages -
  /// nextPages` donne le nombre d'agendas : suivre une pagination n'ouvre pas
  /// un agenda de plus, et ne consomme rien du plafond `maxAgendas`.
  nextPages  Int @default(0)
  retained   Int @default(0)
  submitted  Int @default(0)
  duplicates Int @default(0)
  skipped    Int @default(0)
  errors     Int @default(0)

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  webSearches  Int     @default(0)
  costUsd      Decimal @default(0) @db.Decimal(8, 4)

  /// Date à laquelle les données produites par l'exécution — ses sorties et
  /// ce qu'elle avait mémorisé — ont été supprimées. Le journal, lui, reste :
  /// il dit ce que l'exécution a fait, et ça vaut d'être gardé.
  purgedAt DateTime?

  /// La recherche jouée. Nulle pour une **recherche de source** : celle-ci
  /// n'explore rien, elle rejoue l'étage 7 sur une sortie déjà en base, et
  /// n'a donc ni thème, ni zone, ni période à recevoir d'une configuration.
  config   ScraperConfig? @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId Int?

  /// La sortie dont on cherche la source, quand un modérateur l'a demandé
  /// depuis sa fiche. Renseigné exactement quand `configId` ne l'est pas :
  /// c'est ce champ qui dit au worker de ne jouer que l'attribution.
  ///
  /// `SetNull` plutôt que `Cascade` : la sortie peut disparaître, le journal
  /// de l'exécution reste — il dit ce qui a été cherché, et ça vaut d'être
  /// gardé même quand la fiche n'existe plus.
  event   Event? @relation("SourceHunt", fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  requestedBy   User? @relation("ScraperRunRequester", fields: [requestedById], references: [id])
  requestedById Int?

  items ScraperRunItem[]
  logs  ScraperRunLog[]

  @@index([status, queuedAt])
  @@index([configId])
  @@index([eventId])
}

/// Le journal détaillé d'une exécution, étage par étage.
///
/// `ScraperRunItem` dit le **sort** de chaque page — c'est le verdict, et
/// c'est lui qui alimente la mémoire. Cette table dit le **déroulé** : les
/// requêtes lancées, les liens extraits puis retenus, les prompts envoyés, les
/// jetons consommés. Les deux sont volontairement séparées, pour qu'un bug du
/// journal ne puisse jamais mémoriser quoi que ce soit.
model ScraperRunLog {
  id  Int      @id @default(autoincrement())
  /// Numéro d'ordre émis par le scraper : il pagine sans rien perdre ni rien
  /// répéter, là où l'horodatage a des ex æquo à la seconde près.
  seq Int
  at  DateTime @default(now())

  /// L'un des six étages du pipeline (scraper/sortiesbot/stages.py), ou nul
  /// pour ce qui se passe hors étage — démarrage et clôture du run.
  stage String? @db.VarChar(24)
  /// run_start, stage_start, query, link, page, extract, submit, error…
  kind  String  @db.VarChar(40)
  /// info, warn, error — le filtre de gravité de la console de débogage.
  level String  @default("info") @db.VarChar(8)

  /// La page concernée, quand il y en a une : c'est la clé qui permet de
  /// suivre le parcours d'une même page à travers les six étages.
  url     String? @db.VarChar(500)
  message String? @db.Text
  /// Le reste des champs de l'événement, en JSON.
  data    String? @db.Text

  run   ScraperRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId Int

  @@index([runId, seq])
  @@index([runId, stage])
}

/// Ce qu'un run a fait de chaque page : c'est le journal, consultable depuis
/// la console.
model ScraperRunItem {
  id       Int      @id @default(autoincrement())
  url      String   @db.VarChar(500)
  /// Clé sous laquelle la page a été mémorisée dans `ScrapedUrl`, quand elle
  /// l'a été. Conservée pour pouvoir défaire ce qu'une exécution a mémorisé —
  /// l'URL affichée, elle, reste le lien exact et ne suffit pas à retrouver
  /// la ligne. Nulle pour les exécutions antérieures à ce champ.
  key      String?  @db.VarChar(500)
  title    String?
  /// submitted, dry_run, irrelevant, invalid, duplicate, out_of_period…
  decision String
  reason   String?  @db.Text
  at       DateTime @default(now())

  // ── Provenance ────────────────────────────────────────────────────────
  // D'où venait cette page : l'agenda qui la listait, et la requête web qui a
  // fait remonter cet agenda. Le scraper les journalise déjà (les pistes
  // `agenda` et `query` de `RunLog.trail`), mais dans `ScraperRunLog`, qu'un
  // bouton de la console permet d'oublier — et le journal d'un run de trois
  // mois n'a plus vocation à être gardé. Ces deux colonnes recopient la
  // filiation au moment de la clôture, une fois pour toutes : elle survit
  // ainsi à la purge du journal, et le rendement d'une requête se lit d'une
  // jointure au lieu de s'extraire de deux mille lignes de JSON.
  //
  // Renseignées par le site, jamais par le worker : le scraper n'a pas
  // changé, et il ne devait pas changer pour ça.

  /// L'agenda sur lequel la page a été repérée. Vide quand elle était
  /// elle-même un point de départ — une URL de seed, ou un résultat de
  /// recherche lu tel quel.
  agendaUrl String? @db.VarChar(500)
  /// La requête web qui a remonté cet agenda. Vide en mode « site », et vide
  /// quand le journal ne permettait plus de la retrouver.
  query     String? @db.VarChar(300)

  run   ScraperRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId Int

  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  @@index([runId])
}

/// Mémoire des pages déjà analysées, tous runs et toutes configurations
/// confondus. C'est ce qui empêche de relire — donc de repayer — une page
/// connue, et ce qui évite de reproposer une sortie déjà refusée.
model ScrapedUrl {
  id        Int      @id @default(autoincrement())
  url       String   @unique @db.VarChar(500)
  title     String?
  decision  String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  @@index([decision])
}

// ════════════════════════════════════════════════════════ banc d'évaluation

/// Un agenda du banc d'évaluation : une page réelle dont on veut savoir ce
/// que le dépouillement (étage 3) **aurait dû** en tirer.
///
/// Le principe tient en une phrase : déterminisme n'est pas justesse.
/// `links_of` rend les mêmes liens à chaque fois, ce qui ne dit rien de
/// savoir si ce sont les bons. Aucun signal gratuit ne peut répondre — il n'y
/// a pas, dans le HTML, de déclaration de ce que le site considère comme ses
/// propres fiches. Il faut donc un humain, une fois, pour compléter la
/// moisson ; ensuite l'étiquette ne périme plus jamais, et la mesure se
/// rejoue gratuitement.
///
/// L'extraction, elle, passe par le worker Python et par le vrai `links_of`.
/// La refaire en Node donnerait la vérité d'une réimplémentation, c'est-à-dire
/// aucune vérité du tout.
model EvalAgenda {
  id     Int              @id @default(autoincrement())
  url    String           @unique @db.VarChar(500)
  /// Nom lisible pour la console. Vide : l'URL fait office de nom.
  label  String           @default("")
  status EvalAgendaStatus @default(QUEUED)

  /// Combien de pages dépouiller, la première comprise. C'est un réglage de
  /// l'évaluation, pas celui du pipeline : ici on demande un nombre fixe, là
  /// où l'étage 3 suit sa pagination tant qu'il manque de liens. Ce qu'on
  /// mesure est `links_of` sur une page donnée, pas la politique qui décide
  /// d'en ouvrir une de plus.
  pages Int @default(1)

  error String? @db.Text
  note  String  @default("") @db.Text

  createdAt   DateTime  @default(now())
  analyzedAt  DateTime?
  validatedAt DateTime?

  author      User @relation("EvalAgendaAuthor", fields: [createdById], references: [id])
  createdById Int

  agendaPages EvalAgendaPage[]

  @@index([status])
}

/// Une page réellement téléchargée de cet agenda : la première, puis chaque
/// `rel="next"` suivi. C'est le niveau auquel la console groupe les liens,
/// parce que c'est le niveau auquel `links_of` travaille — une page, une
/// moisson.
model EvalAgendaPage {
  id     Int    @id @default(autoincrement())
  /// Rang de la page dans la pagination : 1 pour l'agenda lui-même.
  pageNo Int
  url    String @db.VarChar(500)

  /// Taille du HTML servi. Un effondrement d'un run à l'autre est le premier
  /// signe qu'un site s'est mis à charger sa liste en JavaScript.
  chars Int     @default(0)
  /// Renseigné quand la page n'a pas pu être lue. Les liens sont alors vides,
  /// et c'est une réponse : la page a été demandée, pas obtenue.
  error String? @db.Text

  /// Le HTML servi ce jour-là, gzippé sur disque. **C'est ce qui fait du banc
  /// un corpus gelé** plutôt qu'un instantané : sans lui, rejouer `links_of`
  /// après l'avoir modifié obligerait à retélécharger, donc à comparer un
  /// nouveau code à une nouvelle page — et l'écart ne dirait plus lequel des
  /// deux a bougé.
  ///
  /// Nul quand la page était injoignable, ou trop lourde pour être archivée :
  /// la mesure tient quand même, seul le rejeu hors ligne s'en trouve privé
  /// pour cette page-là.
  htmlPath String? @db.VarChar(255)

  /// Ce que `next_page()` a trouvé sur cette page — donc ce que l'étage 3
  /// saurait suivre. Comparé aux liens que l'humain étiquette `PAGINATION`,
  /// c'est **la mesure de la pagination** : un agenda qui numérote ses pages
  /// sans `rel="next"` n'est jamais suivi, et rien ailleurs ne le signale.
  ///
  /// Vide quand la page ne déclare pas de suite — ce qui est une réponse.
  nextUrl String @default("") @db.VarChar(500)

  /// Ce qu'un humain dit de cette pagination-là. Nul tant qu'il n'a rien dit.
  ///
  /// Il en faut un **au niveau de la page**, et pas seulement des étiquettes sur
  /// les liens : `next_page()` lit aussi le `<link rel="next">` du `<head>`, qui
  /// n'est pas un `<a href>` et n'apparaît donc dans aucune ligne. L'URL qu'il
  /// en tire était alors invérifiable — la console demandait de l'étiqueter
  /// « pagination » sans qu'aucune ligne ne puisse l'être.
  nextVerdict EvalNextVerdict?

  /// L'adresse de la vraie page suivante, quand l'humain la connaît.
  ///
  /// C'est ce qui manque pour réparer : savoir que l'étage 3 s'est trompé ne
  /// dit pas ce qu'il aurait dû trouver. Une poignée de ces adresses dit tout
  /// de suite si `next_page()` doit apprendre à lire une pagination numérotée.
  nextExpected String @default("") @db.VarChar(500)

  agenda   EvalAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  agendaId Int

  links EvalLink[]

  @@unique([agendaId, pageNo])
  @@index([agendaId])
}

/// Un lien d'une page — **tous** les liens, pas seulement ceux que le
/// dépouillement a retenus.
///
/// C'est le croisement de deux colonnes qui porte la mesure :
///
/// * `harvested` — ce que le **vrai** `links_of` en a fait. C'est la précoche,
///   et elle vient de la fonction de production, jamais d'une relecture de ses
///   règles ;
/// * `verdict` — ce qu'un humain dit que c'est réellement.
///
/// D'où les deux erreurs, là où ne montrer que la moisson n'en donnait qu'une :
/// `harvested` sans `SORTIE` est un lien retenu pour rien, qui coûte un appel
/// payant à l'étage 4 ; `SORTIE` sans `harvested` est une sortie perdue, que
/// personne n'aurait jamais vue.
model EvalLink {
  id      Int            @id @default(autoincrement())
  url     String         @db.VarChar(500)
  /// Texte de l'ancre, tronqué à 150 caractères comme le fait `links_of`.
  text    String         @default("") @db.VarChar(200)
  /// Le texte qui entoure le lien sur la page — là où vivent la date et le
  /// lieu. Renseigné pour les seuls liens retenus : c'est ce que l'étage 4
  /// reçoit, et un lien écarté ne le lui donne jamais.
  context String         @default("") @db.Text
  /// `PAGE` : relevé dans le HTML. `MANUAL` : tapé par un humain, pour ce que
  /// le HTML ne porte pas — une carte rendue en JavaScript, par exemple.
  source  EvalLinkSource @default(PAGE)

  /// Le dépouillement l'a-t-il retenu ? La précoche que l'humain vient
  /// corriger, et le verdict de `links_of` lui-même.
  harvested  Boolean @default(false)
  /// Pourquoi il a été écarté : « texte trop court », « hors domaine »…
  /// Un libellé, pas une décision — il sert à ranger les rejets dans la
  /// console, parce que les ratages se concentrent sous deux ou trois motifs.
  dropReason String  @default("") @db.VarChar(60)
  /// Rang dans le document, pour que la console liste les liens dans l'ordre
  /// où ils se présentent sur la page.
  position   Int     @default(0)

  /// Ce que l'humain dit que ce lien est.
  ///
  /// Jamais nul : l'import y pose déjà la **précoche** de la brique. C'est
  /// pratique et c'est un piège — un lien que personne n'a regardé porte quand
  /// même une étiquette, d'où `reviewed` juste en dessous.
  verdict EvalVerdict?

  /// Un humain a-t-il tranché ce lien, ou est-ce encore la précoche ?
  ///
  /// Sans cette colonne, rien ne distingue « la machine a deviné *autre* » de
  /// « un humain a confirmé *autre* ». On pouvait alors valider un agenda en
  /// n'ayant relu que la moisson, et le rappel affichait 100 % — non pas parce
  /// que la brique n'avait rien raté, mais parce que personne n'avait regardé
  /// le reste. C'est très exactement le mensonge que le banc existe pour
  /// éviter, et il s'était glissé dedans.
  reviewed   Boolean   @default(false)
  reviewedAt DateTime?

  /// Ce que l'humain a tapé pour expliquer sa correction, quand il l'a fait.
  note    String   @default("") @db.Text
  addedAt DateTime @default(now())

  page   EvalAgendaPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId Int

  @@unique([pageId, url])
  @@index([pageId])
  @@index([verdict])
  @@index([reviewed])
}

/// D'où vient un lien du banc : relevé sur la page, ou ajouté à la main.
enum EvalLinkSource {
  PAGE
  MANUAL
}

/// Ce que la pagination d'une page vaut, dit par un humain.
///
/// L'étage 3 ne se contente pas de lire une page : il suit la pagination. Ce
/// verdict-là est donc une mesure de son travail au même titre que le tri des
/// liens, et il lui faut ses propres valeurs — savoir qu'il s'est trompé ne dit
/// pas s'il a raté une suite ou couru après une fausse.
enum EvalNextVerdict {
  /// Ce que la brique a trouvé — ou n'a pas trouvé — est juste.
  CORRECT
  /// Il y a une suite, la brique ne l'a pas vue.
  MANQUEE
  /// La brique a trouvé quelque chose qui n'est pas la suite.
  FAUSSE
}

/// Ce qu'un lien d'agenda est réellement, dit par un humain.
///
/// Quatre, parce que trois ne suffisent pas à décrire ce qu'un agenda contient.
/// `SOUS_AGENDA` est le cas que personne ne comptait : « voir aussi les sorties
/// en château », une page à facettes qui porte d'autres sorties sans être la
/// page suivante. Le dépouillement la rend, la sélection l'écarte parce qu'on
/// lui dit d'écarter les catégories, et ce qu'elle porte n'est jamais atteint.
enum EvalVerdict {
  SORTIE
  PAGINATION
  SOUS_AGENDA
  AUTRE
}

/// Une page du banc de **lecture** (étage 5).
///
/// L'étage 3 se mesure sur des agendas, celui-ci sur des **fiches** : ce ne
/// sont pas les mêmes pages, donc pas le même corpus, donc pas la même table.
///
/// Ce qu'on y mesure, ce sont les trois lectures que l'étage fait d'un même
/// HTML — le texte qui part au modèle, les dates que le site déclare, et
/// l'illustration — plus la décision qui en découle : sous le seuil, la page
/// est abandonnée avant le moindre appel payant.
model EvalReading {
  id     Int              @id @default(autoincrement())
  url    String           @unique @db.VarChar(500)
  label  String           @default("")
  status EvalAgendaStatus @default(QUEUED)
  error  String?          @db.Text
  note   String           @default("") @db.Text

  // ── ce que la brique a rendu
  /// L'adresse réellement lue. Différente quand l'échange de langue a joué :
  /// c'est elle qui serait proposée au site.
  readUrl   String  @default("") @db.VarChar(500)
  swapped   Boolean @default(false)
  /// Le texte tel qu'il partirait au modèle. C'est la pièce à conviction :
  /// sans lui, juger « le texte porte-t-il bien la sortie ? » demanderait de
  /// rouvrir la page, donc de comparer à un HTML qui a pu changer.
  text      String  @default("") @db.Text
  textChars Int     @default(0)
  /// Les dates JSON-LD, en JSON. Une liste vide est une réponse.
  dates     String  @default("[]") @db.Text
  imageUrl  String  @default("") @db.VarChar(500)
  chars     Int     @default(0)
  htmlPath  String? @db.VarChar(255)

  // ── les signaux gratuits : des libellés, pas des décisions
  /// Le premier `h1` de la page, ou son `title` à défaut.
  heading        String  @default("") @db.VarChar(200)
  /// Ce titre se retrouve-t-il dans le texte extrait ? Non : le bloc qui le
  /// portait a été décapé, et avec lui les dates et l'adresse le plus souvent.
  h1InText       Boolean @default(false)
  /// Le texte est au plafond : la fin de la page n'atteindra jamais le modèle.
  truncated      Boolean @default(false)
  /// Sous le seuil de l'étage 5 : la page serait **abandonnée** avant tout
  /// appel payant. Le ratage le plus cher, et le plus silencieux.
  tooShort       Boolean @default(false)
  imageLooksLogo Boolean @default(false)

  // ── ce qu'un humain en dit. Nul tant qu'il n'a rien dit : la brique propose
  //    dans la console, mais rien de sa proposition n'est écrit ici.
  textVerdict  EvalTextVerdict?
  imageVerdict EvalImageVerdict?
  datesVerdict EvalDatesVerdict?

  // ── d'où vient cette page
  /// Saisie à la main, ou tirée d'un run — et de quel côté du tri.
  origin EvalReadingOrigin @default(MANUEL)

  /// La sortie **approuvée** que le pipeline a publiée depuis cette page.
  ///
  /// C'est la vérité de référence de l'étage 6 : approuver, sur ce site, veut
  /// dire qu'un modérateur a vérifié chaque champ. Ce n'est donc pas une
  /// précoche de plus mais une étiquette humaine déjà payée — y compris sur
  /// `setting`, que nul instrument ne sait atteindre.
  ///
  /// Nulle pour une page saisie à la main, et pour toutes celles du panier des
  /// abandons : par définition, elles n'ont produit aucune sortie.
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  /// Quand le pipeline avait lu cette page. Sert à mesurer la **dérive** : la
  /// fiche décrit la page de ce jour-là, le banc la relit aujourd'hui, et aucun
  /// HTML d'époque n'est conservé. Plus l'écart est grand, moins un désaccord
  /// accuse le modèle.
  readAt DateTime?

  /// Ce que le run avait décidé de cette page, et pourquoi — « page vide ou
  /// illisible », le motif d'une erreur réseau. C'est la précoche du panier des
  /// abandons : la brique a dit non, et personne ne l'a jamais vérifié.
  runDecision String @default("") @db.VarChar(40)
  runReason   String @default("") @db.Text

  createdAt   DateTime  @default(now())
  analyzedAt  DateTime?
  validatedAt DateTime?

  author      User @relation("EvalReadingAuthor", fields: [createdById], references: [id])
  createdById Int

  extraction EvalExtraction?

  @@index([status])
  @@index([createdById])
  @@index([origin])
}

/// D'où vient une page du banc de lecture.
///
/// Deux paniers, et l'équilibre entre eux est **la** question de ce banc. Une
/// sortie approuvée est une page où l'étage 5 a réussi : n'en prendre que
/// celles-là mesurerait la brique sur ses propres succès, et donnerait 96 % de
/// textes corrects qui ne voudraient rien dire. Les pages que la lecture a
/// **abandonnées** sont l'autre moitié — personne n'a jamais vérifié si ces
/// abandons étaient justifiés, et c'est très exactement son point aveugle.
enum EvalReadingOrigin {
  /// Saisie à la main dans la console.
  MANUEL
  /// Le pipeline en a tiré une sortie, qu'un modérateur a approuvée.
  APPROUVEE
  /// L'étage 5 l'a écartée — page vide, illisible, ou injoignable.
  ABANDONNEE
}

/// Ce que vaut le texte qu'un étage 5 a tiré d'une page.
///
/// Trois façons de se tromper, et elles ne se réparent pas au même endroit :
/// `AMPUTE` accuse la liste des balises décapées, `TRONQUE` le plafond de
/// caractères, `HORS_SUJET` le fait d'avoir lu la mauvaise page.
enum EvalTextVerdict {
  CORRECT
  AMPUTE
  TRONQUE
  HORS_SUJET
}

/// Ce que vaut l'illustration retenue. `CORRECTE` vaut aussi pour « aucune
/// image, et la page n'en a pas » — la brique a raison de n'en rendre aucune.
enum EvalImageVerdict {
  CORRECTE
  LOGO
  MAUVAISE
  MANQUANTE
}

/// Ce que valent les dates JSON-LD relevées. `CORRECTES` vaut aussi pour
/// « aucune, et la page n'en déclare pas ».
enum EvalDatesVerdict {
  CORRECTES
  INCOMPLETES
  FAUSSES
  MANQUANTES
}

/// Une fiche du banc d'**extraction** (étage 6), adossée à une page du banc de
/// lecture.
///
/// ## Pourquoi elle s'accroche à une lecture plutôt qu'à une URL
///
/// L'étage 6 ne lit pas une page : il lit le **texte** que l'étage 5 lui tend.
/// Rejouer l'extraction sur la page vivante mêlerait deux mesures — une fiche
/// sans tarif ne dirait plus si le modèle l'a raté ou si la lecture l'avait
/// déjà emporté avec un `<aside>`. En partant du texte archivé, l'entrée est
/// acquise, et une fiche fautive accuse bien cet étage-ci.
///
/// C'est aussi ce qui rend le banc économe : la page n'est téléchargée qu'une
/// fois, par l'étage 5, et l'extraction se rejoue autant qu'on veut dessus.
///
/// ## Une seule extraction par page lue
///
/// Comparer deux modèles sur la même page demanderait de garder plusieurs
/// fiches par lecture, donc une notion de campagne. Ce n'est pas ce dont le
/// banc a besoin d'abord : ce qu'il faut savoir, c'est **quels champs se
/// ratent**, et un seul passage le dit. Relancer écrase, et c'est dit dans la
/// console.
model EvalExtraction {
  id     Int              @id @default(autoincrement())
  status EvalAgendaStatus @default(QUEUED)
  error  String?          @db.Text
  note   String           @default("") @db.Text

  /// Le modèle qui a répondu. Une mesure sans le nom du modèle ne se compare à
  /// rien : c'est la première chose qui change entre deux campagnes.
  model String @default("") @db.VarChar(120)

  /// La fiche rendue, en JSON — les vingt-trois champs, entiers.
  ///
  /// Y compris ceux qu'aucun aspect ne juge : c'est la pièce à conviction, et
  /// une mesure dont on ne peut plus relire l'objet n'est pas vérifiable.
  fiche String @default("{}") @db.Text

  /// Les douze aspects, en JSON : libellé, valeur en clair, renseigné ou non,
  /// quel instrument l'a examiné, et les défauts relevés.
  ///
  /// En JSON plutôt qu'en table, et c'est un choix : la liste des aspects est
  /// définie par `evaluation.audit_fiche`, côté Python, et elle bougera. Une
  /// table imposerait une migration à chaque champ ajouté au schéma
  /// d'extraction, pour une mesure qui tient en quelques dizaines de lignes et
  /// que le serveur agrège de toute façon en mémoire.
  aspects String @default("[]") @db.Text

  /// Ce qu'un humain dit de chaque aspect, en JSON : `{"tarif": "JUSTE", …}`.
  ///
  /// Une clé absente veut dire « personne n'a encore regardé » — sans
  /// ambiguïté, et c'est ce qui remplace le `reviewed` de l'étage 3. Les quatre
  /// valeurs sont celles de `EvalFieldVerdict`.
  verdicts String @default("{}") @db.Text

  /// Une fiche approuvée a servi de référence, et les aspects portent donc des
  /// verdicts **proposés**. Proposés, jamais écrits : un verdict qui
  /// s'inscrirait tout seul redeviendrait indiscernable de « personne n'a
  /// regardé », ce que ce banc existe pour éviter.
  hasReference Boolean @default(false)

  /// Le titre approuvé ne se retrouve plus dans le texte : la page a changé
  /// depuis le run, et ce n'est plus la même. Toutes les propositions sont
  /// alors retirées — elles accuseraient le modèle d'un changement du site.
  pageMoved Boolean @default(false)

  /// Ce que l'appel a coûté. Le premier étage du banc dont la mesure se paie :
  /// le taire donnerait l'impression qu'elle est gratuite comme les autres.
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  createdAt   DateTime  @default(now())
  analyzedAt  DateTime?
  validatedAt DateTime?

  reading   EvalReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  readingId Int         @unique

  author      User @relation("EvalExtractionAuthor", fields: [createdById], references: [id])
  createdById Int

  @@index([status])
  @@index([createdById])
}

/// Ce qu'un humain dit d'un champ extrait.
///
/// Quatre, et le croisement avec « le modèle a-t-il rempli ce champ ? » donne
/// les trois taux qui comptent :
///
/// |                | la page le dit      | la page n'en dit rien |
/// |----------------|---------------------|-----------------------|
/// | **renseigné**  | JUSTE, ou FAUX      | **INVENTE**           |
/// | **vide**       | **MANQUE**          | JUSTE (vide à raison) |
///
/// `INVENTE` mérite sa propre valeur plutôt que d'être rangé sous `FAUX` :
/// c'est la faute propre à un modèle, celle qu'aucun code déterministe ne
/// commet, et c'est très exactement celle que l'ancrage sait pré-signaler sans
/// coûter la moindre étiquette. Les mélanger cacherait le seul chiffre qui dit
/// si le prompt tient le modèle.
enum EvalFieldVerdict {
  /// La valeur rendue est celle de la page — ou le champ est vide, et la page
  /// n'en dit rien.
  JUSTE
  /// Une valeur est rendue, la page en donne une autre.
  FAUX
  /// Une valeur est rendue, la page n'en donne aucune.
  INVENTE
  /// Aucune valeur rendue, alors que la page en donne une.
  MANQUE
}
