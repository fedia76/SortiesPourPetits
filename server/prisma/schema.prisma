generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Setting {
  INDOOR
  OUTDOOR
  BOTH
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScraperRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  events          Event[]      @relation("EventAuthor")
  moderatedEvents Event[]      @relation("EventModerator")
  apiKeys         ApiKey[]
  scraperRuns     ScraperRun[] @relation("ScraperRunRequester")
}

/// Clé d'API pour les programmes tiers. La clé en clair n'est jamais stockée :
/// seul son hash SHA-256 l'est, et elle agit avec le rôle du compte rattaché.
model ApiKey {
  id         Int       @id @default(autoincrement())
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@index([userId])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  events Event[]
}

/// Une zone géographique ouverte sur le site : l'Île-de-France, Le Havre…
///
/// Elle existe d'abord pour les visiteurs et les moteurs de recherche. Personne
/// ne cherche « sortie enfant » tout court — on cherche « sortie enfant Nancy »,
/// et il faut une page qui réponde exactement à cette question, avec son propre
/// titre et son propre texte.
///
/// L'appartenance se décide sur le code postal du lieu, par préfixes : c'est le
/// mécanisme que les recherches automatiques utilisent déjà (`postalPrefixes`),
/// il ne dépend d'aucun géocodage, et redessiner une zone revient à modifier
/// une liste.
model Area {
  id             Int      @id @default(autoincrement())
  /// Ce qui apparaît dans l'adresse : « ile-de-france ».
  slug           String   @unique
  name           String   @unique
  /// Préfixes de code postal séparés par des virgules : « 75,77,78,91 ».
  postalPrefixes String
  /// Texte de présentation, affiché en tête de page et repris en description.
  /// C'est ce qui distingue la page d'une simple liste filtrée.
  intro          String   @db.Text
  /// Ordre d'affichage dans les menus et les listes.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
}

model Venue {
  id         Int     @id @default(autoincrement())
  name       String
  address    String
  city       String
  postalCode String
  lat        Decimal @db.Decimal(9, 6)
  lng        Decimal @db.Decimal(9, 6)

  events Event[]

  @@index([lat, lng])
  @@index([postalCode])
}

model Event {
  id              Int         @id @default(autoincrement())
  title           String
  description     String      @db.Text
  /// Le **meilleur lien connu** pour cette sortie : la page de l'organisateur
  /// quand on a su la trouver, la page où elle a été repérée sinon. C'est
  /// celui que la fiche montre, et il n'a jamais changé de rôle — de sorte
  /// qu'aucun lecteur de ce champ n'a eu à apprendre les deux suivants.
  sourceUrl       String?
  /// La page où la recherche automatique a trouvé la sortie, quand elle
  /// diffère de `sourceUrl` — typiquement un agrégateur qui republiait
  /// l'information d'un musée. Vide pour une proposition de visiteur, et vide
  /// aussi quand la page lue était déjà la bonne : ce champ ne se remplit que
  /// s'il apprend quelque chose.
  foundOnUrl      String?
  /// Ce qui a désigné `sourceUrl` : `json_ld`, `venue_domain`, `page_link`,
  /// `search` (l'étage attribution du scraper, du plus sûr au moins sûr) ou
  /// `manuel` quand un humain l'a saisi ou corrigé. Le modérateur voit ainsi
  /// quelle confiance accorder au lien qu'on lui propose.
  sourceUrlSignal String?
  isFree          Boolean     @default(false)
  price           Decimal?    @db.Decimal(8, 2)
  photoUrl        String?
  ageMin          Int?
  ageMax          Int?
  isPermanent     Boolean     @default(false)
  dateStart       DateTime?   @db.Date
  dateEnd         DateTime?   @db.Date
  openTime        String? // "HH:MM", valable tous les jours de l'évènement
  closeTime       String? // "HH:MM", valable tous les jours de l'évènement
  setting         Setting?
  status          EventStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime    @default(now())

  venue   Venue @relation(fields: [venueId], references: [id])
  venueId Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  author      User @relation("EventAuthor", fields: [createdById], references: [id])
  createdById Int

  moderator     User? @relation("EventModerator", fields: [moderatedById], references: [id])
  moderatedById Int?

  /// Jours où la sortie a effectivement lieu. Vide = tous les jours de la
  /// période, ce qui reste le cas le plus courant.
  dates EventDate[]

  scraperItems ScraperRunItem[]
  scrapedUrls  ScrapedUrl[]
  /// Les recherches de source demandées sur cette sortie depuis sa fiche.
  sourceHunts  ScraperRun[] @relation("SourceHunt")

  @@index([status, dateEnd])
  @@index([createdById])
  @@index([categoryId])
}

/// Une recherche paramétrée du scraper. Le thème, la période et la zone
/// orientent la recherche ; ils ne filtrent pas le résultat (voir
/// `keepOutOfScope`). Plusieurs configurations spécialisées se complètent :
/// chacune ratisse son angle et ramasse au passage ce que les autres ratent.
/// Un jour de représentation.
///
/// `dateStart`/`dateEnd` bornent la sortie et servent à l'affichage ; ces
/// lignes disent quels jours de cette période elle a réellement lieu. Un
/// spectacle joué tous les dimanches de juillet et août en a neuf — sans quoi
/// il ressortirait un jeudi.
///
/// Aucune ligne veut dire « tous les jours de la période » : c'est le cas
/// d'une exposition ou d'une fête foraine, et c'était le seul modèle possible
/// avant cette table.
model EventDate {
  id      Int      @id @default(autoincrement())
  day     DateTime @db.Date
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  @@unique([eventId, day])
  @@index([day])
}

/// Un **agrégateur** : un grand agenda qui republie — kidiklik, citizenkid,
/// sortiraparis…
///
/// Ce sont d'excellents points d'entrée — ils indexent tout et sortent en tête
/// des recherches — mais un atelier du musée Rodin est une information du
/// musée Rodin. Le scraper les lit, puis remonte à la page de l'organisateur,
/// et c'est celle-là qu'il propose.
///
/// La liste est **commune à toutes les recherches** : une même page vaut la
/// même chose quelle que soit la recherche qui l'a trouvée, et la régler
/// recherche par recherche revenait à la recopier à chaque fois — donc à
/// l'oublier quelque part. Chaque recherche décide seulement, par une case à
/// cocher, si elle les lit ou les refuse.
model Aggregator {
  id      Int     @id @default(autoincrement())
  /// Le domaine, sans `www.` ni schéma : `kidiklik.fr`. Les sous-domaines en
  /// relèvent aussi — le scraper compare la fin de l'hôte.
  domain  String  @unique
  /// Nom lisible, pour la console. Vide : le domaine fait office de nom.
  label   String  @default("")
  /// Faux : le site cesse d'être tenu pour un agrégateur. Ses pages peuvent
  /// alors servir de source à une sortie, et une recherche qui bloque les
  /// agrégateurs ne le bloquera pas. La ligne est conservée : on saura
  /// pourquoi elle avait été écrite.
  enabled Boolean @default(true)
  /// Ce qu'on a constaté sur ce site — utile au prochain qui se demandera
  /// pourquoi il est là, ou pourquoi il a été désactivé.
  note    String  @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScraperConfig {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  enabled Boolean @default(true)

  /// « recherche » (le modèle cherche sur le web) ou « site » (on part
  /// d'adresses connues, sans la moindre recherche). Les configurations
  /// existantes gardent « recherche » et le chemin qu'elles avaient.
  mode     String @default("recherche")
  /// Points de départ du mode « site », une URL par ligne. Vide ailleurs.
  seedUrls String @default("") @db.Text

  theme       String @db.Text
  area        String @default("Île-de-France")
  period      String @default("les prochaines semaines")
  horizonDays Int    @default(30)

  maxEvents         Int     @default(20)
  maxSearches       Int     @default(6)
  maxAgendas        Int     @default(6)
  /// Pages suivantes d'un agenda, suivies tant que la moisson est maigre.
  maxNextPages      Int     @default(2)
  maxLinksPerAgenda Int     @default(8)
  maxPageChars      Int     @default(8000)
  maxCostUsd        Decimal @default(1.00) @db.Decimal(6, 2)
  keepOutOfScope    Boolean @default(true)

  defaultCategory  String  @default("Non classé")
  /// Préfixes de codes postaux visés, séparés par des virgules.
  postalPrefixes   String  @default("75,77,78,91,92,93,94,95")
  /// Ne pas seulement remonter à la source depuis un agrégateur : refuser de
  /// le lire. La liste, elle, est commune au site (`Aggregator`) et ne se
  /// règle plus recherche par recherche. Les pages illisibles (réseaux
  /// sociaux) restent écartées dans tous les cas, par le scraper.
  blockAggregators Boolean @default(false)
  /// Autorise l'attribution à *chercher* la page de l'organisateur quand la
  /// page lue ne la porte pas. Son seul appel payant, ~0,001 $ la fiche.
  sourceSearch     Boolean @default(true)

  /// Qui lance les recherches : « anthropic » (outil serveur) ou « serper »
  /// (Google). Le modèle reste derrière dans les deux cas pour le reste.
  provider        String @default("anthropic")
  /// Tranche la nature d'une page quand aucun signal certain ne la donne.
  /// Vide : on ne demande à personne, et la page part en agenda.
  classifyModel   String @default("claude-haiku-4-5")
  searchModel     String @default("claude-haiku-4-5")
  selectModel     String @default("claude-haiku-4-5")
  extractionModel String @default("claude-haiku-4-5")

  /// Requêtes imposées, une par ligne. Vide : le modèle les formule.
  queries String? @db.Text

  /// Prompts personnalisés ; vides, le scraper utilise les siens.
  queriesPrompt         String? @db.Text
  classifyPrompt        String? @db.Text
  searchPrompt          String? @db.Text
  selectPrompt          String? @db.Text
  extractionPrompt      String? @db.Text
  /// Lecture d'une page de programme, qui porte plusieurs sorties (mode « site »).
  extractionMultiPrompt String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ScraperRun[]
}

/// Une exécution : mise en file depuis la console, prise en charge par le
/// worker, puis close avec ses compteurs.
model ScraperRun {
  id     Int              @id @default(autoincrement())
  status ScraperRunStatus @default(QUEUED)
  /// Faux : le run explore sans rien proposer au site.
  submit Boolean          @default(false)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?   @db.Text

  candidates Int @default(0)
  /// Pages d'agenda téléchargées, pages suivantes comprises.
  pages      Int @default(0)
  /// Celles qui n'étaient pas la première page d'un agenda. `pages -
  /// nextPages` donne le nombre d'agendas : suivre une pagination n'ouvre pas
  /// un agenda de plus, et ne consomme rien du plafond `maxAgendas`.
  nextPages  Int @default(0)
  retained   Int @default(0)
  submitted  Int @default(0)
  duplicates Int @default(0)
  skipped    Int @default(0)
  errors     Int @default(0)

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  webSearches  Int     @default(0)
  costUsd      Decimal @default(0) @db.Decimal(8, 4)

  /// Date à laquelle les données produites par l'exécution — ses sorties et
  /// ce qu'elle avait mémorisé — ont été supprimées. Le journal, lui, reste :
  /// il dit ce que l'exécution a fait, et ça vaut d'être gardé.
  purgedAt DateTime?

  /// La recherche jouée. Nulle pour une **recherche de source** : celle-ci
  /// n'explore rien, elle rejoue l'étage 7 sur une sortie déjà en base, et
  /// n'a donc ni thème, ni zone, ni période à recevoir d'une configuration.
  config   ScraperConfig? @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId Int?

  /// La sortie dont on cherche la source, quand un modérateur l'a demandé
  /// depuis sa fiche. Renseigné exactement quand `configId` ne l'est pas :
  /// c'est ce champ qui dit au worker de ne jouer que l'attribution.
  ///
  /// `SetNull` plutôt que `Cascade` : la sortie peut disparaître, le journal
  /// de l'exécution reste — il dit ce qui a été cherché, et ça vaut d'être
  /// gardé même quand la fiche n'existe plus.
  event   Event? @relation("SourceHunt", fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  requestedBy   User? @relation("ScraperRunRequester", fields: [requestedById], references: [id])
  requestedById Int?

  items ScraperRunItem[]
  logs  ScraperRunLog[]

  @@index([status, queuedAt])
  @@index([configId])
  @@index([eventId])
}

/// Le journal détaillé d'une exécution, étage par étage.
///
/// `ScraperRunItem` dit le **sort** de chaque page — c'est le verdict, et
/// c'est lui qui alimente la mémoire. Cette table dit le **déroulé** : les
/// requêtes lancées, les liens extraits puis retenus, les prompts envoyés, les
/// jetons consommés. Les deux sont volontairement séparées, pour qu'un bug du
/// journal ne puisse jamais mémoriser quoi que ce soit.
model ScraperRunLog {
  id  Int      @id @default(autoincrement())
  /// Numéro d'ordre émis par le scraper : il pagine sans rien perdre ni rien
  /// répéter, là où l'horodatage a des ex æquo à la seconde près.
  seq Int
  at  DateTime @default(now())

  /// L'un des six étages du pipeline (scraper/sortiesbot/stages.py), ou nul
  /// pour ce qui se passe hors étage — démarrage et clôture du run.
  stage String? @db.VarChar(24)
  /// run_start, stage_start, query, link, page, extract, submit, error…
  kind  String  @db.VarChar(40)
  /// info, warn, error — le filtre de gravité de la console de débogage.
  level String  @default("info") @db.VarChar(8)

  /// La page concernée, quand il y en a une : c'est la clé qui permet de
  /// suivre le parcours d'une même page à travers les six étages.
  url     String? @db.VarChar(500)
  message String? @db.Text
  /// Le reste des champs de l'événement, en JSON.
  data    String? @db.Text

  run   ScraperRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId Int

  @@index([runId, seq])
  @@index([runId, stage])
}

/// Ce qu'un run a fait de chaque page : c'est le journal, consultable depuis
/// la console.
model ScraperRunItem {
  id       Int      @id @default(autoincrement())
  url      String   @db.VarChar(500)
  /// Clé sous laquelle la page a été mémorisée dans `ScrapedUrl`, quand elle
  /// l'a été. Conservée pour pouvoir défaire ce qu'une exécution a mémorisé —
  /// l'URL affichée, elle, reste le lien exact et ne suffit pas à retrouver
  /// la ligne. Nulle pour les exécutions antérieures à ce champ.
  key      String?  @db.VarChar(500)
  title    String?
  /// submitted, dry_run, irrelevant, invalid, duplicate, out_of_period…
  decision String
  reason   String?  @db.Text
  at       DateTime @default(now())

  run   ScraperRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId Int

  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  @@index([runId])
}

/// Mémoire des pages déjà analysées, tous runs et toutes configurations
/// confondus. C'est ce qui empêche de relire — donc de repayer — une page
/// connue, et ce qui évite de reproposer une sortie déjà refusée.
model ScrapedUrl {
  id        Int      @id @default(autoincrement())
  url       String   @unique @db.VarChar(500)
  title     String?
  decision  String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  @@index([decision])
}
