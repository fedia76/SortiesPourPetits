generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum Setting {
  INDOOR
  OUTDOOR
  BOTH
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pourquoi une sortie a été refusée — la version comptable du motif.
///
/// Le texte libre reste (`Event.rejectionReason`) : c'est lui que l'auteur
/// lit, et aucune liste ne dira jamais tout d'un cas particulier. Mais du
/// texte libre ne s'additionne pas — « pas pour les enfants », « trop vieux »
/// et « 12+ » sont une seule information et trois chaînes — et il ne pouvait
/// donc rien apprendre au scraper.
///
/// La règle qui a présidé au choix de ces valeurs : **un motif n'est utile
/// que s'il désigne un étage.** Chacune ci-dessous se lit comme un reproche
/// adressé à une brique précise du pipeline ; ce qui n'en désigne aucune n'a
/// rien à faire ici et reste dans le texte libre, sous `AUTRE`.
enum RejectionCode {
  /// Ce n'est pas une sortie. Étages 2 (reconnaissance) et 6 (extraction).
  HORS_SUJET
  /// C'en est une, mais pas pour ce public. Étages 1 (requête) et 6 (prompt).
  PAS_POUR_ENFANTS
  /// Les dates sont fausses. Étage 6, et `schedule.py`.
  DATE_FAUSSE
  /// Le lieu est faux ou introuvable. Étage 6, et `geocode.py`.
  LIEU_FAUX
  /// Le tarif est faux. Étage 6.
  TARIF_FAUX
  /// La description est inutilisable — tronquée, illisible, hors sujet.
  /// Étage 5 (lecture) avant l'étage 6 : c'est là que le texte se fabrique.
  DESCRIPTION_INUTILISABLE
  /// `sourceUrl` ne mène pas à cette sortie. Étage 7 (attribution).
  MAUVAIS_LIEN
  /// La sortie est déjà au catalogue. Le dédoublonnage, qui ne connaît
  /// aujourd'hui que les URL.
  DOUBLON
  /// La sortie est passée. `payload._clean_dates`, et la fraîcheur d'un run.
  DEJA_PASSEE
  /// Aucun étage en cause, ou plusieurs : le texte libre fait foi.
  AUTRE
}

enum ScraperRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  events          Event[]      @relation("EventAuthor")
  moderatedEvents Event[]      @relation("EventModerator")
  apiKeys         ApiKey[]
  scraperRuns     ScraperRun[] @relation("ScraperRunRequester")
  evalAgendas     EvalAgenda[] @relation("EvalAgendaAuthor")
  evalSorties     EvalSortie[] @relation("EvalSortieAuthor")
  evalFiches      EvalFiche[]  @relation("EvalFicheAuthor")
  evalLinkLabels  EvalLink[]   @relation("EvalLinkLabeller")
  evalRuns        EvalRun[]    @relation("EvalRunRequester")
}

/// Clé d'API pour les programmes tiers. La clé en clair n'est jamais stockée :
/// seul son hash SHA-256 l'est, et elle agit avec le rôle du compte rattaché.
model ApiKey {
  id         Int       @id @default(autoincrement())
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@index([userId])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  events Event[]
}

/// Une zone géographique ouverte sur le site : l'Île-de-France, Le Havre…
///
/// Elle existe d'abord pour les visiteurs et les moteurs de recherche. Personne
/// ne cherche « sortie enfant » tout court — on cherche « sortie enfant Nancy »,
/// et il faut une page qui réponde exactement à cette question, avec son propre
/// titre et son propre texte.
///
/// L'appartenance se décide sur le code postal du lieu, par préfixes : c'est le
/// mécanisme que les recherches automatiques utilisent déjà (`postalPrefixes`),
/// il ne dépend d'aucun géocodage, et redessiner une zone revient à modifier
/// une liste.
model Area {
  id             Int      @id @default(autoincrement())
  /// Ce qui apparaît dans l'adresse : « ile-de-france ».
  slug           String   @unique
  name           String   @unique
  /// Préfixes de code postal séparés par des virgules : « 75,77,78,91 ».
  postalPrefixes String
  /// Texte de présentation, affiché en tête de page et repris en description.
  /// C'est ce qui distingue la page d'une simple liste filtrée.
  intro          String   @db.Text
  /// Ordre d'affichage dans les menus et les listes.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
}

model Venue {
  id         Int     @id @default(autoincrement())
  name       String
  address    String
  city       String
  postalCode String
  lat        Decimal @db.Decimal(9, 6)
  lng        Decimal @db.Decimal(9, 6)

  events Event[]

  @@index([lat, lng])
  @@index([postalCode])
}

model Event {
  id              Int            @id @default(autoincrement())
  title           String
  description     String         @db.Text
  /// Le **meilleur lien connu** pour cette sortie : la page de l'organisateur
  /// quand on a su la trouver, la page où elle a été repérée sinon. C'est
  /// celui que la fiche montre, et il n'a jamais changé de rôle — de sorte
  /// qu'aucun lecteur de ce champ n'a eu à apprendre les deux suivants.
  sourceUrl       String?
  /// La page où la recherche automatique a trouvé la sortie, quand elle
  /// diffère de `sourceUrl` — typiquement un agrégateur qui republiait
  /// l'information d'un musée. Vide pour une proposition de visiteur, et vide
  /// aussi quand la page lue était déjà la bonne : ce champ ne se remplit que
  /// s'il apprend quelque chose.
  foundOnUrl      String?
  /// Ce qui a désigné `sourceUrl` : `json_ld`, `venue_domain`, `page_link`,
  /// `search` (l'étage attribution du scraper, du plus sûr au moins sûr) ou
  /// `manuel` quand un humain l'a saisi ou corrigé. Le modérateur voit ainsi
  /// quelle confiance accorder au lien qu'on lui propose.
  sourceUrlSignal String?
  isFree          Boolean        @default(false)
  price           Decimal?       @db.Decimal(8, 2)
  photoUrl        String?
  ageMin          Int?
  ageMax          Int?
  isPermanent     Boolean        @default(false)
  dateStart       DateTime?      @db.Date
  dateEnd         DateTime?      @db.Date
  openTime        String? // "HH:MM", valable tous les jours de l'évènement
  closeTime       String? // "HH:MM", valable tous les jours de l'évènement
  setting         Setting?
  status          EventStatus    @default(PENDING)
  rejectionReason String?
  /// Le même refus, sous une forme qui s'additionne. Nul pour les sorties
  /// refusées avant ce champ, et pour celles qui ne sont pas refusées.
  rejectionCode   RejectionCode?
  createdAt       DateTime       @default(now())

  venue   Venue @relation(fields: [venueId], references: [id])
  venueId Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  author      User @relation("EventAuthor", fields: [createdById], references: [id])
  createdById Int

  moderator     User? @relation("EventModerator", fields: [moderatedById], references: [id])
  moderatedById Int?

  /// Jours où la sortie a effectivement lieu. Vide = tous les jours de la
  /// période, ce qui reste le cas le plus courant.
  dates EventDate[]

  scraperItems ScraperRunItem[]
  scrapedUrls  ScrapedUrl[]
  /// Ce qu'un modérateur a corrigé avant d'approuver cette fiche.
  corrections  EventCorrection[]
  /// Les pages du banc de lecture dont cette sortie est la vérité de référence.
  evalSorties  EvalSortie[]
  /// Les recherches de source demandées sur cette sortie depuis sa fiche.
  sourceHunts  ScraperRun[]      @relation("SourceHunt")

  @@index([status, dateEnd])
  @@index([createdById])
  @@index([categoryId])
}

/// Une recherche paramétrée du scraper. Le thème, la période et la zone
/// orientent la recherche ; ils ne filtrent pas le résultat (voir
/// `keepOutOfScope`). Plusieurs configurations spécialisées se complètent :
/// chacune ratisse son angle et ramasse au passage ce que les autres ratent.
/// Un jour de représentation.
///
/// `dateStart`/`dateEnd` bornent la sortie et servent à l'affichage ; ces
/// lignes disent quels jours de cette période elle a réellement lieu. Un
/// spectacle joué tous les dimanches de juillet et août en a neuf — sans quoi
/// il ressortirait un jeudi.
///
/// Aucune ligne veut dire « tous les jours de la période » : c'est le cas
/// d'une exposition ou d'une fête foraine, et c'était le seul modèle possible
/// avant cette table.
model EventDate {
  id      Int      @id @default(autoincrement())
  day     DateTime @db.Date
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  @@unique([eventId, day])
  @@index([day])
}

/// Un champ qu'un modérateur a corrigé sur une fiche importée, avant de la
/// juger. Une ligne par champ, et la valeur d'avant comme celle d'après.
///
/// C'est la vérité terrain la moins chère du projet : personne n'étiquette
/// rien, on enregistre un geste que la modération faisait déjà. Et c'est la
/// seule qui dise **où** l'extraction se trompe — un taux d'approbation dit
/// qu'une fiche était mauvaise, cette table dit que c'était la ville.
///
/// Elle ne se remplit que dans un cas étroit, et c'est délibéré : une fiche
/// encore en attente, importée par la recherche automatique. Une retouche
/// éditoriale six mois après approbation n'est pas une erreur d'extraction, et
/// la compter ici brouillerait la mesure comme le comptage de liens avait
/// brouillé le classifieur.
model EventCorrection {
  id      Int      @id @default(autoincrement())
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int
  /// Le champ de la fiche, sous le nom que lui donne l'API : `title`,
  /// `venueCity`, `price`, `dateStart`… Le même vocabulaire que le payload du
  /// scraper, pour que la mesure se lise en regard de l'étage 6.
  field   String   @db.VarChar(40)
  /// Ce que le scraper avait proposé, et ce que l'humain a mis à la place.
  /// Tronqués : on mesure une fréquence, on ne rejoue pas la fiche.
  before  String?  @db.VarChar(500)
  after   String?  @db.VarChar(500)
  at      DateTime @default(now())

  @@index([eventId])
  @@index([field])
}

/// Un **agrégateur** : un grand agenda qui republie — kidiklik, citizenkid,
/// sortiraparis…
///
/// Ce sont d'excellents points d'entrée — ils indexent tout et sortent en tête
/// des recherches — mais un atelier du musée Rodin est une information du
/// musée Rodin. Le scraper les lit, puis remonte à la page de l'organisateur,
/// et c'est celle-là qu'il propose.
///
/// La liste est **commune à toutes les recherches** : une même page vaut la
/// même chose quelle que soit la recherche qui l'a trouvée, et la régler
/// recherche par recherche revenait à la recopier à chaque fois — donc à
/// l'oublier quelque part. Chaque recherche décide seulement, par une case à
/// cocher, si elle les lit ou les refuse.
model Aggregator {
  id      Int     @id @default(autoincrement())
  /// Le domaine, sans `www.` ni schéma : `kidiklik.fr`. Les sous-domaines en
  /// relèvent aussi — le scraper compare la fin de l'hôte.
  domain  String  @unique
  /// Nom lisible, pour la console. Vide : le domaine fait office de nom.
  label   String  @default("")
  /// Faux : le site cesse d'être tenu pour un agrégateur. Ses pages peuvent
  /// alors servir de source à une sortie, et une recherche qui bloque les
  /// agrégateurs ne le bloquera pas. La ligne est conservée : on saura
  /// pourquoi elle avait été écrite.
  enabled Boolean @default(true)
  /// Ce qu'on a constaté sur ce site — utile au prochain qui se demandera
  /// pourquoi il est là, ou pourquoi il a été désactivé.
  note    String  @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScraperConfig {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  enabled Boolean @default(true)

  /// « recherche » (le modèle cherche sur le web) ou « site » (on part
  /// d'adresses connues, sans la moindre recherche). Les configurations
  /// existantes gardent « recherche » et le chemin qu'elles avaient.
  mode     String @default("recherche")
  /// Points de départ du mode « site », une URL par ligne. Vide ailleurs.
  seedUrls String @default("") @db.Text

  theme       String @db.Text
  area        String @default("Île-de-France")
  period      String @default("les prochaines semaines")
  horizonDays Int    @default(30)

  maxEvents         Int     @default(20)
  maxSearches       Int     @default(6)
  maxAgendas        Int     @default(6)
  /// Pages suivantes d'un agenda, suivies tant que la moisson est maigre.
  maxNextPages      Int     @default(2)
  maxLinksPerAgenda Int     @default(8)
  maxPageChars      Int     @default(8000)
  maxCostUsd        Decimal @default(1.00) @db.Decimal(6, 2)
  keepOutOfScope    Boolean @default(true)

  defaultCategory  String  @default("Non classé")
  /// Préfixes de codes postaux visés, séparés par des virgules.
  postalPrefixes   String  @default("75,77,78,91,92,93,94,95")
  /// Ne pas seulement remonter à la source depuis un agrégateur : refuser de
  /// le lire. La liste, elle, est commune au site (`Aggregator`) et ne se
  /// règle plus recherche par recherche. Les pages illisibles (réseaux
  /// sociaux) restent écartées dans tous les cas, par le scraper.
  blockAggregators Boolean @default(false)
  /// Autorise l'attribution à *chercher* la page de l'organisateur quand la
  /// page lue ne la porte pas. Son seul appel payant, ~0,001 $ la fiche.
  sourceSearch     Boolean @default(true)

  /// Qui lance les recherches : « anthropic » (outil serveur) ou « serper »
  /// (Google). Le modèle reste derrière dans les deux cas pour le reste.
  provider        String @default("anthropic")
  /// Tranche la nature d'une page quand aucun signal certain ne la donne.
  /// Vide : on ne demande à personne, et la page part en agenda.
  classifyModel   String @default("claude-haiku-4-5")
  searchModel     String @default("claude-haiku-4-5")
  selectModel     String @default("claude-haiku-4-5")
  extractionModel String @default("claude-haiku-4-5")

  /// Requêtes imposées, une par ligne. Vide : le modèle les formule.
  queries String? @db.Text

  /// Prompts personnalisés ; vides, le scraper utilise les siens.
  queriesPrompt         String? @db.Text
  classifyPrompt        String? @db.Text
  searchPrompt          String? @db.Text
  selectPrompt          String? @db.Text
  extractionPrompt      String? @db.Text
  /// Lecture d'une page de programme, qui porte plusieurs sorties (mode « site »).
  extractionMultiPrompt String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ScraperRun[]
}

/// Une exécution : mise en file depuis la console, prise en charge par le
/// worker, puis close avec ses compteurs.
model ScraperRun {
  id     Int              @id @default(autoincrement())
  status ScraperRunStatus @default(QUEUED)
  /// Faux : le run explore sans rien proposer au site.
  submit Boolean          @default(false)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?   @db.Text

  candidates Int @default(0)
  /// Pages d'agenda téléchargées, pages suivantes comprises.
  pages      Int @default(0)
  /// Celles qui n'étaient pas la première page d'un agenda. `pages -
  /// nextPages` donne le nombre d'agendas : suivre une pagination n'ouvre pas
  /// un agenda de plus, et ne consomme rien du plafond `maxAgendas`.
  nextPages  Int @default(0)
  retained   Int @default(0)
  submitted  Int @default(0)
  duplicates Int @default(0)
  skipped    Int @default(0)
  errors     Int @default(0)

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  webSearches  Int     @default(0)
  costUsd      Decimal @default(0) @db.Decimal(8, 4)

  /// Date à laquelle les données produites par l'exécution — ses sorties et
  /// ce qu'elle avait mémorisé — ont été supprimées. Le journal, lui, reste :
  /// il dit ce que l'exécution a fait, et ça vaut d'être gardé.
  purgedAt DateTime?

  /// La recherche jouée. Nulle pour une **recherche de source** : celle-ci
  /// n'explore rien, elle rejoue l'étage 7 sur une sortie déjà en base, et
  /// n'a donc ni thème, ni zone, ni période à recevoir d'une configuration.
  config   ScraperConfig? @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId Int?

  /// La sortie dont on cherche la source, quand un modérateur l'a demandé
  /// depuis sa fiche. Renseigné exactement quand `configId` ne l'est pas :
  /// c'est ce champ qui dit au worker de ne jouer que l'attribution.
  ///
  /// `SetNull` plutôt que `Cascade` : la sortie peut disparaître, le journal
  /// de l'exécution reste — il dit ce qui a été cherché, et ça vaut d'être
  /// gardé même quand la fiche n'existe plus.
  event   Event? @relation("SourceHunt", fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  requestedBy   User? @relation("ScraperRunRequester", fields: [requestedById], references: [id])
  requestedById Int?

  items ScraperRunItem[]
  logs  ScraperRunLog[]

  @@index([status, queuedAt])
  @@index([configId])
  @@index([eventId])
}

/// Le journal détaillé d'une exécution, étage par étage.
///
/// `ScraperRunItem` dit le **sort** de chaque page — c'est le verdict, et
/// c'est lui qui alimente la mémoire. Cette table dit le **déroulé** : les
/// requêtes lancées, les liens extraits puis retenus, les prompts envoyés, les
/// jetons consommés. Les deux sont volontairement séparées, pour qu'un bug du
/// journal ne puisse jamais mémoriser quoi que ce soit.
model ScraperRunLog {
  id  Int      @id @default(autoincrement())
  /// Numéro d'ordre émis par le scraper : il pagine sans rien perdre ni rien
  /// répéter, là où l'horodatage a des ex æquo à la seconde près.
  seq Int
  at  DateTime @default(now())

  /// L'un des six étages du pipeline (scraper/sortiesbot/stages.py), ou nul
  /// pour ce qui se passe hors étage — démarrage et clôture du run.
  stage String? @db.VarChar(24)
  /// run_start, stage_start, query, link, page, extract, submit, error…
  kind  String  @db.VarChar(40)
  /// info, warn, error — le filtre de gravité de la console de débogage.
  level String  @default("info") @db.VarChar(8)

  /// La page concernée, quand il y en a une : c'est la clé qui permet de
  /// suivre le parcours d'une même page à travers les six étages.
  url     String? @db.VarChar(500)
  message String? @db.Text
  /// Le reste des champs de l'événement, en JSON.
  data    String? @db.Text

  run   ScraperRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId Int

  @@index([runId, seq])
  @@index([runId, stage])
}

/// Ce qu'un run a fait de chaque page : c'est le journal, consultable depuis
/// la console.
model ScraperRunItem {
  id       Int      @id @default(autoincrement())
  url      String   @db.VarChar(500)
  /// Clé sous laquelle la page a été mémorisée dans `ScrapedUrl`, quand elle
  /// l'a été. Conservée pour pouvoir défaire ce qu'une exécution a mémorisé —
  /// l'URL affichée, elle, reste le lien exact et ne suffit pas à retrouver
  /// la ligne. Nulle pour les exécutions antérieures à ce champ.
  key      String?  @db.VarChar(500)
  title    String?
  /// submitted, dry_run, irrelevant, invalid, duplicate, out_of_period…
  decision String
  reason   String?  @db.Text
  at       DateTime @default(now())

  // ── Provenance ────────────────────────────────────────────────────────
  // D'où venait cette page : l'agenda qui la listait, et la requête web qui a
  // fait remonter cet agenda. Le scraper les journalise déjà (les pistes
  // `agenda` et `query` de `RunLog.trail`), mais dans `ScraperRunLog`, qu'un
  // bouton de la console permet d'oublier — et le journal d'un run de trois
  // mois n'a plus vocation à être gardé. Ces deux colonnes recopient la
  // filiation au moment de la clôture, une fois pour toutes : elle survit
  // ainsi à la purge du journal, et le rendement d'une requête se lit d'une
  // jointure au lieu de s'extraire de deux mille lignes de JSON.
  //
  // Renseignées par le site, jamais par le worker : le scraper n'a pas
  // changé, et il ne devait pas changer pour ça.

  /// L'agenda sur lequel la page a été repérée. Vide quand elle était
  /// elle-même un point de départ — une URL de seed, ou un résultat de
  /// recherche lu tel quel.
  agendaUrl String? @db.VarChar(500)
  /// La requête web qui a remonté cet agenda. Vide en mode « site », et vide
  /// quand le journal ne permettait plus de la retrouver.
  query     String? @db.VarChar(300)

  run   ScraperRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId Int

  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  @@index([runId])
}

/// Mémoire des pages déjà analysées, tous runs et toutes configurations
/// confondus. C'est ce qui empêche de relire — donc de repayer — une page
/// connue, et ce qui évite de reproposer une sortie déjà refusée.
model ScrapedUrl {
  id        Int      @id @default(autoincrement())
  url       String   @unique @db.VarChar(500)
  title     String?
  decision  String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId Int?

  @@index([decision])
}

// ════════════════════════════════════════════════════════ banc d'évaluation
//
// Trois choses, et elles vivaient dans les mêmes lignes. C'est ce mélange qui
// rendait le banc incapable de faire ce pour quoi il existe :
//
//   * le **corpus** — une entrée gelée et ce qu'un humain dit qu'elle
//     contient. Ça vit des années, ça ne dépend d'aucun modèle, et c'est la
//     seule chose qui coûte cher à produire ;
//   * un **run** — ce qu'une brique, à sa version du jour, rend sur ce
//     corpus. Immuable, empilé, jamais écrasé ;
//   * la **mesure** — la confrontation des deux. Calculée, jamais stockée.
//
// Avant cette séparation, rejouer un agenda supprimait ses pages, donc en
// cascade tous les verdicts humains qu'il portait ; rejouer une page de
// lecture réécrivait son texte et son HTML gelé, laissant des étiquettes qui
// décrivaient un objet disparu. Autrement dit : mesurer deux fois était soit
// impossible, soit mensonger — et « est-ce que ça s'améliore ? » restait sans
// réponse.
//
// ## Ce que la séparation fait disparaître
//
// `reviewed` n'existe plus : une ligne d'étiquette existe **parce qu'**un
// humain l'a posée, et son absence dit « personne n'a regardé » sans
// ambiguïté. `hasReference` n'existe plus : une proposition est un run qu'on
// affiche, pas un état qu'on stocke. `pageMoved` n'existe plus : un run rejoue
// sur l'entrée gelée, jamais sur le web d'aujourd'hui.
//
// ## L'étiquette dit ce que la page contient, jamais si la brique a eu raison
//
// C'est la règle qui a présidé à tout ce qui suit, et elle change la nature
// des étiquettes. « le tarif est JUSTE » juge une sortie de modèle : elle ne
// veut rien dire sans elle, et elle périme au premier changement de prompt.
// « la page annonce 8 € » décrit la page : elle vaut pour toujours, et
// n'importe quel run se compare à elle tout seul.
//
// Les verdicts d'autrefois — CORRECT, AMPUTE, JUSTE, INVENTE — n'ont pas
// disparu pour autant : ils sont **dérivés** au moment de la mesure, en
// confrontant ce que le run a rendu à ce que le corpus déclare.

/// Où en est la **capture** d'une entrée du corpus — le gel de son HTML.
///
/// À ne pas confondre avec un run : capturer construit le corpus, mesurer
/// l'interroge. Une entrée capturée l'est une fois pour toutes ; recapturer
/// crée une nouvelle entrée plutôt que d'écraser celle qui porte les
/// étiquettes.
enum EvalCaptureStatus {
  QUEUED
  RUNNING
  CAPTURED
  FAILED
}

/// La brique qu'un run mesure. Les quatre qui ont une entrée gelable.
///
/// Les étages 1 et 7 en sont absents, et ce n'est pas un oubli : la découverte
/// interroge le web vivant et l'attribution télécharge des pages candidates.
/// Leurs runs ne seraient pas rejouables, donc pas comparables — ce qui est
/// tout ce qu'on demande à un banc.
enum EvalStage {
  HARVEST
  SELECT
  READ
  EXTRACT
}

enum EvalRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// ─────────────────────────────────────────────────────────── LE CORPUS

/// Un agenda du corpus : une page réelle dont on veut savoir ce que le
/// dépouillement **aurait dû** en tirer.
///
/// Le principe tient en une phrase : déterminisme n'est pas justesse.
/// `links_of` rend les mêmes liens à chaque fois, ce qui ne dit rien de savoir
/// si ce sont les bons. Aucun signal gratuit ne peut répondre — il n'y a pas,
/// dans le HTML, de déclaration de ce que le site considère comme ses propres
/// fiches. Il faut donc un humain, une fois ; ensuite l'étiquette ne périme
/// plus jamais et la mesure se rejoue gratuitement.
model EvalAgenda {
  id    Int    @id @default(autoincrement())
  url   String @unique @db.VarChar(500)
  /// Nom lisible pour la console. Vide : l'URL fait office de nom.
  label String @default("")

  /// Combien de pages capturer, la première comprise. C'est un réglage du
  /// corpus, pas celui du pipeline : ici on demande un nombre fixe, là où
  /// l'étage 3 suit sa pagination tant qu'il manque de liens. Ce qu'on mesure
  /// est `links_of` sur une page donnée, pas la politique qui décide d'en
  /// ouvrir une de plus.
  pages Int @default(1)

  capture      EvalCaptureStatus @default(QUEUED)
  captureError String?           @db.Text
  capturedAt   DateTime?
  note         String            @default("") @db.Text
  createdAt    DateTime          @default(now())

  author      User @relation("EvalAgendaAuthor", fields: [createdById], references: [id])
  createdById Int

  agendaPages EvalAgendaPage[]

  @@index([capture])
}

/// Une page capturée d'un agenda : le HTML d'un jour, gelé, et ce qu'un humain
/// dit de sa pagination.
model EvalAgendaPage {
  id     Int    @id @default(autoincrement())
  /// Rang de la page dans la pagination : 1 pour l'agenda lui-même.
  pageNo Int
  url    String @db.VarChar(500)

  /// Taille du HTML servi, au moment de la capture.
  chars Int @default(0)

  /// Le HTML servi ce jour-là, gzippé sur disque. **C'est ce qui fait du
  /// corpus un corpus** plutôt qu'un instantané : un run le rejoue hors ligne,
  /// donc un écart entre deux runs ne peut venir que du code — jamais du site,
  /// qui a pu changer entre-temps.
  ///
  /// Écrit à la capture, **jamais réécrit**. Recapturer une page crée une
  /// nouvelle entrée : sans quoi les étiquettes se retrouveraient à décrire un
  /// HTML qui n'existe plus, ce qui est pire que de les avoir perdues.
  htmlPath String? @db.VarChar(255)

  /// L'adresse de la vraie page suivante, telle qu'un humain la connaît.
  ///
  /// Trois états, et il en faut trois : `null` — personne n'a regardé ; `""` —
  /// il n'y a pas de suite, et c'est une étiquette ; une URL — la voici. Le
  /// verdict d'autrefois (CORRECT / MANQUEE / FAUSSE) se déduit de la
  /// comparaison avec ce qu'un run a trouvé, au lieu d'être figé contre un
  /// seul passage.
  nextExpected String? @db.VarChar(500)

  agenda   EvalAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  agendaId Int

  links           EvalLink[]
  evalLinkResults EvalLinkResult[]

  @@unique([agendaId, pageNo])
  @@index([agendaId])
}

/// Ce qu'un humain dit d'un lien d'une page d'agenda.
///
/// **Cette table ne contient que des étiquettes.** Une ligne existe parce
/// qu'un humain l'a posée ; son absence dit que personne n'a regardé, sans
/// ambiguïté possible. C'est ce qui remplace l'ancien `reviewed`, et c'est
/// mieux qu'une colonne : on ne peut plus valider un agenda en n'ayant relu
/// que la moisson, ce qui affichait autrefois un rappel de 100 % pour la
/// seule raison que personne n'avait regardé le reste.
///
/// Ce que la brique a fait de ce lien — retenu ou écarté, et pourquoi — est
/// dans `EvalLinkResult`, une fois par run.
model EvalLink {
  id   Int    @id @default(autoincrement())
  url  String @db.VarChar(500)
  /// Texte de l'ancre au moment de l'étiquetage, pour que la console puisse
  /// afficher la ligne sans rejouer quoi que ce soit.
  text String @default("") @db.VarChar(200)

  /// `PAGE` : le lien figure dans le HTML gelé. `MANUAL` : tapé par un humain,
  /// pour ce que le HTML ne porte pas — une carte rendue en JavaScript, par
  /// exemple. Un lien `MANUAL` étiqueté `SORTIE` est le seul moyen de mesurer
  /// ce qu'aucun `links_of` ne pourra jamais trouver.
  source EvalLinkSource @default(PAGE)

  /// Ce que ce lien est. Jamais nul : la ligne n'existerait pas.
  verdict EvalVerdict

  // ── vers quelle sortie ce lien mène ────────────────────────────────────
  //
  // Un lien d'agenda ne décrit pas une sortie : il y mène. Ce qu'elle est —
  // sa date, son lieu, son âge — appartient à `EvalSortie`, qui le dit une
  // fois pour les étages 4, 5 et 6.
  //
  // Ce champ a remplacé trois colonnes (`dateHint`, `placeHint`, `audience`)
  // qui redécrivaient ici, en plus pauvre, ce qu'`EvalSortie` disait déjà —
  // et sans que rien ne joigne les deux descriptions. Leur contenu a été
  // versé dans les sorties correspondantes.
  //
  // Nul sur un lien étiqueté `SORTIE` veut dire : personne n'a encore décrit
  // cette sortie. Le lien est alors *indécidable* pour l'étage 4 — il ne
  // compte ni pour ni contre —, et il apparaît dans la liste de travail.
  // Nul sur tout autre verdict est l'état normal : une pagination n'a pas de
  // sortie derrière elle.
  sortie   EvalSortie? @relation(fields: [sortieId], references: [id], onDelete: SetNull)
  sortieId Int?

  /// D'où vient l'étiquette. `HUMAIN` : quelqu'un l'a tranchée dans la
  /// console. `MODERATION` : la page pointée par ce lien est devenue une
  /// sortie qu'un modérateur a approuvée — c'est un humain qui l'a vérifiée,
  /// fiche en main, donc c'est une étiquette et non une supposition.
  origin EvalLabelOrigin @default(HUMAIN)

  note       String   @default("") @db.Text
  labelledAt DateTime @default(now())

  /// Nul pour une étiquette venue de la modération : elle n'a pas d'auteur
  /// dans la console.
  labelledBy   User? @relation("EvalLinkLabeller", fields: [labelledById], references: [id])
  labelledById Int?

  page   EvalAgendaPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId Int

  @@unique([pageId, url])
  @@index([pageId])
  @@index([verdict])
  @@index([sortieId])
}

enum EvalLinkSource {
  PAGE
  MANUAL
}

/// Qui a posé une étiquette.
///
/// Les deux valent : un modérateur qui approuve une sortie a vérifié chaque
/// champ de la fiche, page ouverte à côté. C'est le même travail humain que
/// dans la console du banc, simplement fait ailleurs et déjà payé.
enum EvalLabelOrigin {
  HUMAIN
  MODERATION
}

/**
 * Pour qui la sortie est, d'après sa page.
 * `INDETERMINE` est une étiquette de plein droit — « la page n'annonce aucun
 * public » —, à distinguer du silence, qui est l'absence de valeur (`null`).
 * Sans les deux états, « personne n'a regardé » et « la page n'en dit rien »
 * se confondraient.
 * Renseignée à part de `ageMin`/`ageMax` parce qu'une page peut afficher
 * « jeune public » sans le moindre chiffre, et l'inverse. Quand elle est nulle,
 * `audienceOf` la déduit de l'âge : c'est ce qui rend la moisson depuis la
 * modération utile à l'étage 4, `Event` portant les âges mais aucun champ de
 * public.
 */
enum EvalAudience {
  ENFANTS
  ADULTES
  INDETERMINE
}

enum EvalVerdict {
  SORTIE
  PAGINATION
  SOUS_AGENDA
  AUTRE
}

/// **Une sortie du corpus** : son HTML gelé, et ce qu'un humain dit qu'elle est.
///
/// C'est l'objet des étages 4, 5 et 6, et il n'y en a qu'un. Une sortie est
/// décrite **une fois, complètement** ; chaque étage lit ensuite le
/// sous-ensemble dont il répond, et ignore le reste — l'étage 4 regarde la
/// date, le lieu et l'âge, jamais le tarif, qui est pourtant sur l'étiquette.
///
/// C'est ce qui manquait. L'étage 4 avait un temps ses propres « indices »
/// posés sur le lien d'agenda : la même sortie s'y trouvait décrite une
/// seconde fois, plus pauvrement, sans que rien ne joigne les deux. Un lien
/// d'agenda ne décrit plus une sortie — il **pointe** vers elle.
model EvalSortie {
  id    Int    @id @default(autoincrement())
  url   String @unique @db.VarChar(500)
  label String @default("")

  capture      EvalCaptureStatus @default(QUEUED)
  captureError String?           @db.Text
  capturedAt   DateTime?
  /// Taille du HTML capturé.
  chars        Int               @default(0)
  htmlPath     String?           @db.VarChar(255)
  note         String            @default("") @db.Text

  // ── les étiquettes : ce que la page contient, pas ce que la brique a rendu
  //
  //    Chacune a trois états — `null` : personne n'a regardé ; une valeur
  //    vide : la page n'en porte pas, et c'est une étiquette ; une valeur :
  //    la voici. Sans le second état, « pas d'image sur la page » et « pas
  //    encore étiqueté » seraient le même silence.

  /// L'illustration que la page porte vraiment, ou `""` si elle n'en a pas.
  expectedImage   String? @db.VarChar(500)
  /// Les dates que la page annonce, en JSON. `"[]"` : elle n'en annonce pas.
  expectedDates   String? @db.Text
  /// Quelques fragments que le texte extrait **doit** contenir — le titre, le
  /// tarif, l'adresse. En JSON.
  ///
  /// On ne demande pas à un humain de retaper le texte attendu : ce serait
  /// invivable et personne ne le ferait deux fois. On lui demande ce qui ne
  /// doit pas manquer, ce qui se coche en quelques secondes depuis la page —
  /// et ça suffit à distinguer un texte amputé d'un texte entier, qui est très
  /// exactement la question de cet étage.
  expectedMarkers String? @db.Text

  // ── ce que l'étage 4 juge : la date, le lieu, l'âge ────────────────────
  //
  // Stockés en **faits structurés**, et non dans la prose de `EvalFiche`.
  // Celle-ci porte bien « du 2026-09-20 au 2026-09-22 », « dès 3 ans »,
  // « 12 rue X, 75012, Paris » — mais ce sont des chaînes destinées à être
  // comparées à ce que le modèle a rendu, et leur forme est définie en Python.
  // Les relire ici demanderait d'écrire en TypeScript un analyseur du format
  // d'un autre langage : deux implémentations d'une seule convention, qui
  // divergeraient en silence au premier changement de rendu.
  //
  // Une date se compare à une fenêtre, un code postal à des préfixes, un âge
  // à « jeune public ». Il faut donc les faits, pas leur mise en forme. C'est
  // aussi ce qui rend la moisson depuis la modération gratuite : `Event` et
  // `Venue` portent déjà ces colonnes, structurées, vérifiées par un humain.
  //
  // `null` partout : personne n'a regardé. La sortie est alors *indécidable*
  // et n'entre dans aucun dénominateur — jamais un reproche au modèle.

  /// Premier et dernier jour de la sortie. `dateEnd` nul sur une date unique.
  dateStart  DateTime?     @db.Date
  dateEnd    DateTime?     @db.Date
  /// Le code postal, à cinq chiffres. Une ville en toutes lettres ne situe
  /// rien de comparable : elle a sa place dans `EvalFiche`, pas ici.
  postalCode String?       @db.VarChar(10)
  /// L'âge annoncé. Les deux nuls sans être `audience` nulle veut dire que la
  /// page annonce un public sans donner de tranche — « en famille ».
  ageMin     Int?
  ageMax     Int?
  /// À qui la sortie s'adresse. Renseignée à part parce qu'une page peut
  /// afficher « jeune public » sans le moindre chiffre, et l'inverse.
  audience   EvalAudience?

  // ── d'où vient cette page, et pourquoi elle est au corpus
  origin      EvalSortieOrigin @default(MANUEL)
  /// La sortie approuvée que le pipeline avait publiée depuis cette page.
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     Int?
  /// Quand le pipeline avait lu cette page, et ce qu'il en avait décidé. C'est
  /// de la provenance : ça dit pourquoi la page mérite d'être au corpus, ça ne
  /// dit rien de ce qu'elle contient.
  readAt      DateTime?
  runDecision String           @default("") @db.VarChar(40)
  runReason   String           @default("") @db.Text

  createdAt   DateTime @default(now())
  author      User     @relation("EvalSortieAuthor", fields: [createdById], references: [id])
  createdById Int

  fiche              EvalFiche?
  evalReadResults    EvalReadResult[]
  evalExtractResults EvalExtractResult[]
  /// Les liens d'agenda qui mènent à cette sortie. Plusieurs agendas peuvent
  /// annoncer la même : c'est une seule sortie, décrite une seule fois.
  links              EvalLink[]

  @@index([capture])
  @@index([origin])
}

enum EvalSortieOrigin {
  /// Saisie à la main dans la console.
  MANUEL
  /// Le pipeline en a tiré une sortie, qu'un modérateur a approuvée.
  APPROUVEE
  /// L'étage 5 l'a écartée — page vide, illisible, ou injoignable.
  ABANDONNEE
  /// Une fiche en est sortie, qu'un modérateur a refusée pour description
  /// inutilisable. Le point aveugle de cet étage : la page n'était pas vide —
  /// elle a passé le seuil, elle a coûté une extraction — mais son texte ne
  /// valait rien. Rien ne capturait ce cas.
  ILLISIBLE
}

/// Le corpus de l'extraction : ce que la page annonce, champ par champ.
///
/// L'étiquette n'est plus « le tarif rendu est JUSTE » — un jugement qui n'a
/// de sens que face à une fiche donnée, et qui périme au premier changement de
/// prompt. Elle est « la page annonce 8 € », qui décrit la page et vaut pour
/// toujours. Les quatre verdicts d'autrefois se **dérivent** alors tout seuls,
/// pour n'importe quel run :
///
///   attendu renseigné, rendu identique   → JUSTE
///   attendu renseigné, rendu différent   → FAUX
///   attendu vide,      rendu renseigné   → INVENTE
///   attendu renseigné, rendu vide        → MANQUE
///
/// C'est aussi ce qui permet à la modération de fournir des étiquettes sans
/// rien savoir du banc : `EventCorrection.after` est très exactement « ce que
/// la page annonce », vérifié par un humain la fiche sous les yeux.
model EvalFiche {
  id Int @id @default(autoincrement())

  /// Ce que la page annonce, par champ, en JSON : `{"tarif": "8 €", …}`.
  ///
  /// En JSON plutôt qu'en table : la liste des champs est définie par
  /// `evaluation.audit_fiche`, côté Python, et elle bougera. Une table
  /// imposerait une migration à chaque champ ajouté, pour une mesure que le
  /// serveur agrège de toute façon en mémoire.
  ///
  /// Une clé absente veut dire « personne n'a regardé ce champ » ; une clé
  /// présente et vide veut dire « la page n'en dit rien », ce qui est une
  /// étiquette et permet de reconnaître une valeur inventée.
  /// Ce que la page annonce, **en faits**, dans la forme même que la brique
  /// rend : `{"free": false, "price": 8, "ageMin": 3, "ageMax": null, …}`.
  ///
  /// Elle portait autrefois la mise en forme — « gratuit », « dès 3 ans » —,
  /// parce que la mesure comparait les libellés que `audit_fiche` calcule pour
  /// l'affichage. Or la donnée est structurée aux deux bouts : le modèle rend
  /// `ageMin`, la sortie publiée porte la colonne `ageMin`. Comparer la prose
  /// au milieu obligeait à réécrire en TypeScript un format défini en Python,
  /// et un point-virgule déplacé faisait compter « faux » tous les tarifs.
  ///
  /// Une clé absente veut dire « personne n'a regardé ce champ » ; une clé
  /// présente et vide veut dire « la page n'en dit rien », ce qui est une
  /// étiquette et permet de reconnaître une valeur inventée.
  expected String @default("{}") @db.Text

  /// L'ancienne étiquette, en toutes lettres, gardée telle quelle.
  ///
  /// Elle n'entre dans aucune mesure : on ne rouvre pas de la prose pour en
  /// tirer des faits, c'est précisément ce qu'on vient d'arrêter de faire.
  /// Elle reste lisible pour qu'un humain puisse retrouver ce qu'une étiquette
  /// disait, le temps que le corpus se reconstruise — la plupart des fiches se
  /// remoissonnent d'un clic. À supprimer quand ce sera fait.
  expectedLegacy String? @db.Text

  /// D'où vient chaque champ, en JSON : `{"tarif": "CORRIGE", …}`.
  ///
  /// `CORRIGE` — un modérateur a réécrit ce champ avant d'approuver. C'est une
  /// étiquette indépendante du modèle, la plus forte qu'on ait.
  /// `NON_CONTREDIT` — le modèle l'a rendu, le modérateur l'a laissé passer.
  /// `SAISIE` — quelqu'un l'a tapé dans la console.
  ///
  /// **La mesure les traite à égalité.** L'hypothèse retenue est qu'approuver,
  /// c'est avoir vérifié chaque champ, fiche en main ; sous cette hypothèse un
  /// champ non contredit est une étiquette de plein droit.
  ///
  /// La distinction est conservée quand même, et c'est tout son intérêt : une
  /// hypothèse sur le comportement des gens vieillit. Si un jour le taux de
  /// correction s'effondre sur tous les champs à la fois, c'est qu'on n'aura
  /// plus le droit de la tenir — et on ne pourra le voir que si on l'a notée.
  /// La couler dans les données en ne notant rien la rendrait invérifiable
  /// pour toujours, ce qui coûte plus cher qu'une colonne.
  origins  String @default("{}") @db.Text

  note       String   @default("") @db.Text
  labelledAt DateTime @default(now())

  sortie   EvalSortie @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  sortieId Int        @unique

  author      User @relation("EvalFicheAuthor", fields: [createdById], references: [id])
  createdById Int
}

// ─────────────────────────────────────────────────────────────── LES RUNS

/// Une exécution du banc : une brique, à une version donnée, sur un corpus.
///
/// Immuable. On n'écrase pas un run, on en ajoute un — c'est toute la
/// différence avec ce qui existait avant, et c'est ce qui rend la question
/// « est-ce que ça s'améliore ? » enfin posable.
///
/// Les colonnes de version ne sont pas du confort : sans elles, une courbe qui
/// monte ou descend n'est attribuable à rien. Et elles sont irrattrapables
/// après coup — un run déjà joué ne dira jamais ce qu'il était.
model EvalRun {
  id     Int           @id @default(autoincrement())
  stage  EvalStage
  status EvalRunStatus @default(QUEUED)
  error  String?       @db.Text

  /// Nom donné au run par qui l'a lancé — « après le correctif d'encodage ».
  /// C'est ce qui rend un point de la courbe lisible six mois plus tard.
  label String @default("") @db.VarChar(150)

  // ── de quoi ce run est-il le run
  /// La révision du dépôt qui tournait. Vide si le worker ne sait pas la dire.
  codeRef    String @default("") @db.VarChar(60)
  /// Le modèle interrogé, pour les deux étages qui en appellent un.
  model      String @default("") @db.VarChar(120)
  /// Empreinte du prompt : deux runs de même empreinte sont comparables sur
  /// le modèle seul, deux runs d'empreintes différentes ne le sont pas.
  promptHash String @default("") @db.VarChar(64)
  /// Les réglages en vigueur, en JSON — plafonds, seuils, options.
  settings   String @default("{}") @db.Text

  // ── ce qu'il a coûté. Nul pour les étages de Python pur.
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  /// Nombre d'entrées du corpus soumises à ce run.
  items Int @default(0)

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  requestedBy   User? @relation("EvalRunRequester", fields: [requestedById], references: [id])
  requestedById Int?

  linkResults    EvalLinkResult[]
  readResults    EvalReadResult[]
  extractResults EvalExtractResult[]

  @@index([stage, queuedAt])
  @@index([status])
}

/// Ce qu'un run des étages 3 et 4 a fait d'un lien d'une page.
///
/// Une ligne par lien **relevé par la brique**, étiqueté ou non : un lien que
/// le run trouve et que le corpus ne connaît pas est un trou du corpus, et
/// c'est une information — elle se lit dans la mesure sous « non étiqueté ».
model EvalLinkResult {
  id      Int    @id @default(autoincrement())
  url     String @db.VarChar(500)
  /// Texte et contexte tels que `links_of` les a rendus **ce jour-là**. Le
  /// contexte est l'entrée de l'étage 4 : c'est ce qui permet de le mesurer
  /// sur la sortie de l'étage 3, comme en production.
  text    String @default("") @db.VarChar(200)
  context String @default("") @db.Text

  /// Étage 3 : le lien a-t-il été retenu par `links_of`, et sinon pourquoi.
  harvested  Boolean @default(false)
  dropReason String  @default("") @db.VarChar(60)
  position   Int     @default(0)

  /// Étage 4 : le modèle l'a-t-il retenu, et sur quel motif. Nuls pour un run
  /// de l'étage 3, qui ne pose pas cette question.
  selected     Boolean?
  selectReason String   @default("") @db.Text

  run    EvalRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId  Int
  page   EvalAgendaPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId Int

  @@unique([runId, pageId, url])
  @@index([runId])
  @@index([pageId])
}

/// Ce qu'un run de l'étage 5 a tiré d'une page du corpus.
model EvalReadResult {
  id Int @id @default(autoincrement())

  /// L'adresse réellement lue : différente quand l'échange de langue a joué.
  readUrl String  @default("") @db.VarChar(500)
  swapped Boolean @default(false)

  /// Le texte tel qu'il partirait au modèle. La pièce à conviction : sans lui,
  /// juger « le texte porte-t-il bien la sortie ? » demanderait de rouvrir la
  /// page, donc de comparer à un HTML qui a pu changer.
  text      String @default("") @db.Text
  textChars Int    @default(0)
  /// Les dates JSON-LD relevées, en JSON.
  dates     String @default("[]") @db.Text
  imageUrl  String @default("") @db.VarChar(500)

  // ── les signaux gratuits : des constats, pas des verdicts
  heading        String  @default("") @db.VarChar(200)
  h1InText       Boolean @default(false)
  truncated      Boolean @default(false)
  tooShort       Boolean @default(false)
  imageLooksLogo Boolean @default(false)

  error String? @db.Text

  run      EvalRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId    Int
  sortie   EvalSortie @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  sortieId Int

  @@unique([runId, sortieId])
  @@index([runId])
  @@index([sortieId])
}

/// Ce qu'un run de l'étage 6 a rendu sur le texte d'une page du corpus.
model EvalExtractResult {
  id Int @id @default(autoincrement())

  /// La fiche rendue, en JSON — tous les champs, entiers. La pièce à
  /// conviction : une mesure dont on ne peut plus relire l'objet n'est pas
  /// vérifiable.
  fiche   String @default("{}") @db.Text
  /// Les aspects relevés par `evaluation.audit_fiche`, en JSON : libellé,
  /// valeur en clair, renseigné ou non, l'instrument qui l'a examiné et les
  /// défauts constatés. Des constats, jamais des verdicts — ceux-ci se
  /// dérivent de la comparaison au corpus, au moment de la mesure.
  aspects String @default("[]") @db.Text

  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)

  error String? @db.Text

  run      EvalRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId    Int
  sortie   EvalSortie @relation(fields: [sortieId], references: [id], onDelete: Cascade)
  sortieId Int

  @@unique([runId, sortieId])
  @@index([runId])
  @@index([sortieId])
}
