# Copiez ce fichier en `.env` **sur le VPS**, à côté du docker-compose.yml,
# et remplissez-le avec des valeurs tirées au sort.
#
# Ce `.env` ne part jamais du dépôt : il se crée une fois sur le serveur et il
# y reste. Le déploiement l'épargne explicitement (`--exclude 'umami/.env'`
# dans .github/workflows/deploy.yml) — sans cette ligne, le `rsync --delete`
# du dossier `deploy/` l'effacerait à la première mise en ligne, et la pile ne
# redémarrerait plus.

# Mot de passe de la base PostgreSQL d'Umami. Elle n'est jamais jointe depuis
# l'extérieur du réseau Docker, mais un mot de passe par défaut reste un mot de
# passe par défaut.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret de signature des sessions du tableau de bord.
#   openssl rand -hex 32
APP_SECRET=

# Clé de chiffrement de la double authentification. Exactement 64 caractères
# hexadécimaux, sans quoi Umami refuse de démarrer.
#   openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=
