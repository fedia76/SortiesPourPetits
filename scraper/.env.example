# Clé de l'API Claude (https://console.anthropic.com) — utilisée par le fournisseur "anthropic".
ANTHROPIC_API_KEY=sk-ant-...

# API SortiesPourPetits : URL de base et clé d'API créée depuis /cles-api.
# Le worker (python -m sortiesbot.worker) exige les deux clés : il lit les
# recherches et la mémoire des pages dans la base du site. En ligne de
# commande, un dry-run se contente de ANTHROPIC_API_KEY.
SPP_API_URL=https://sortiespourpetits.fr
SPP_API_KEY=spp_...

# Moteur de recherche. Deux usages, indépendants l'un de l'autre :
#  - les configurations dont `provider: serper` cherchent avec lui (étage 1) ;
#  - l'étage attribution s'en sert pour remonter à la page de l'organisateur
#    quand la page lue ne la cite pas — quel que soit le fournisseur choisi.
# Sans elle : « anthropic » reste le seul fournisseur, et l'attribution s'en
# tient à ses trois signaux gratuits.
SERPER_API_KEY=
